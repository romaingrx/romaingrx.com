---
import { Icon } from 'astro-icon/components';
import { Badge } from '@/components/ui/badge';

type CategoryConfig = {
  name: string;
  icon: string;
  backgroundColor: string;
  textColor: string;
};

const categories = {
  skills: {
    name: 'Skills',
    icon: 'lucide:train',
    backgroundColor: 'var(--chart-1)',
    textColor: 'oklch(0.2 0 0)',
  },
  brain: {
    name: 'Brain clarity',
    icon: 'lucide:brain',
    backgroundColor: 'var(--chart-2)',
    textColor: 'oklch(0.2 0 0)',
  },
  health: {
    name: 'Health',
    icon: 'lucide:heart',
    backgroundColor: 'var(--chart-3)',
    textColor: 'oklch(0.2 0 0)',
  },
  time: {
    name: 'Time management',
    icon: 'lucide:clock',
    backgroundColor: 'var(--chart-4)',
    textColor: 'oklch(0.2 0 0)',
  },
  social: {
    name: 'Social',
    icon: 'lucide:network',
    backgroundColor: 'var(--chart-5)',
    textColor: 'oklch(0.2 0 0)',
  },
} as const satisfies Record<string, CategoryConfig>;
const categoriesKeys = Object.keys(categories);

export type Category = keyof typeof categories;

export type Props = {
  category: Category;
};

const { category } = Astro.props;

if (!categoriesKeys.includes(category)) {
  throw new Error(`Category ${category} not found, please choose in ${categoriesKeys}`);
}

const { icon, backgroundColor, textColor } = categories[category];
---

<Badge style={{ backgroundColor, color: textColor }} class="flex items-center gap-1 text-xs [&>svg]:size-4">
  <Icon name={icon} />
  <span class="text-xs font-medium">{categories[category].name}</span>
</Badge>

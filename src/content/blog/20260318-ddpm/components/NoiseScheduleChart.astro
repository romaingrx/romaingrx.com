---
import ChartCard from '@/components/charts/chart-card.astro';
import LineChart from '@/components/charts/line-chart.astro';

import noise_schedule from '../data/noise_schedule.json';
---

<ChartCard
  title="Cosine noise schedule"
  description="β and cumulative ᾱ over 1000 timesteps"
  class="my-8"
>
  <LineChart
    x={noise_schedule.t}
    xAxis={{ domain: [0, 1000], ticks: [0, 200, 400, 600, 800, 1000] }}
    yAxis={{ format: (v) => v.toFixed(3) }}
    y2Axis={{ domain: [0, 1], ticks: [0, 0.25, 0.5, 0.75, 1] }}
    tooltipTitle={(t) => `t = ${t}`}
    series={[
      { label: 'βₜ', color: 'var(--chart-1)', values: noise_schedule.beta },
      { label: 'ᾱₜ', color: 'var(--chart-2)', values: noise_schedule.alpha_bar, axis: 'right' },
    ]}
  />
</ChartCard>

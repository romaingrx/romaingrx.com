---
import ChartCard from '@/components/charts/chart-card.astro';
import ScatterChart from '@/components/charts/scatter-chart.astro';

import latent_space from '../data/latent_space.json';

/** Purple-to-magenta color hashed from the start of a sequence. */
function seqColor(seq: string): string {
  let hash = 0;
  for (let i = 0; i < Math.min(seq.length, 10); i++) {
    hash = seq.charCodeAt(i) + ((hash << 5) - hash);
  }
  const hue = 240 + (((hash % 80) + 80) % 80); // 240-320: purple to magenta
  const lightness = 40 + ((((hash >> 8) % 25) + 25) % 25); // 40-65%
  return `hsl(${hue}, 55%, ${lightness}%)`;
}

const residues = new Set(latent_space.flatMap((p) => [...p.sequence]));
const charColors = Object.fromEntries([...residues].map((aa) => [aa, seqColor(aa)]));

const points = latent_space.map(({ z: [x, y], sequence }) => ({
  x,
  y,
  color: seqColor(sequence),
  title: `z = [${x.toFixed(2)}, ${y.toFixed(2)}]`,
  detail: sequence,
  note: `${sequence.length} residues`,
}));
---

<ChartCard
  title="Latent space"
  description="Each protein sequence encoded as a 2D point. Hover to inspect."
  class="my-4"
>
  <ScatterChart
    points={points}
    charColors={charColors}
    xAxis={{ label: 'z₁', domain: [-6, 6], ticks: [-6, -3, 0, 3, 6] }}
    yAxis={{ label: 'z₂', domain: [-6, 6], ticks: [-6, -3, 0, 3, 6] }}
  />
</ChartCard>

---
import { PageHeader } from '@/components/patterns/page-header';
import { Container } from '@/components/ui/container';
import { Link } from '@/components/ui/link';
import { Text } from '@/components/ui/text';
import { socialLinks } from '@/configs/social';
import BaseLayout from '@/layouts/BaseLayout.astro';

const linkedIn = socialLinks.find((link) => link.platform === 'linkedin');
if (!linkedIn) throw new Error('LinkedIn contact link is not configured.');

const title = 'Contact';
const description =
  'Always open to discussing interesting ideas or projects, and available for consulting work in machine learning and full-stack applications.';
---

<BaseLayout title={title} description={description}>
  <Container as="section" size="content" class="max-w-2xl py-16 md:py-24">
    <PageHeader title={title} class="mb-6" />
    <Text size="lg" tone="muted">
      Have an interesting idea or project? I'm always open to a conversation.
    </Text>
    <Text tone="muted" class="mt-3 mb-8">
      I also take on consulting work in machine learning and full-stack applications.
    </Text>
    <Link href={linkedIn.url}>Message me on LinkedIn</Link>
  </Container>
</BaseLayout>

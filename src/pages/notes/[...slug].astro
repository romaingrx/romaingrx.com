---
import { render } from 'astro:content';
import EntryFooter from '@/components/entry/entry-footer.astro';
import { components } from '@/components/mdx';
import NoteHeader from '@/components/note/note-header.astro';
import { Container } from '@/components/ui/container';
import { Prose } from '@/components/ui/prose';
import EntryLayout from '@/layouts/entry-layout.astro';
import { getEntries, type Note } from '@/lib/collections';

export async function getStaticPaths() {
  return (await getEntries('note')).map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

type Props = { note: Note };

const { note } = Astro.props;
const { Content } = await render(note);
---

<EntryLayout entry={note}>
  <NoteHeader note={note} />
  <Container size="article">
    <Prose as="article" data-pagefind-body data-pagefind-meta={`title:${note.data.title}`}>
      <Content components={components} />
    </Prose>
    <EntryFooter entry={note} />
  </Container>
</EntryLayout>

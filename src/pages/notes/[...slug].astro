---
import { render } from 'astro:content';
import { components } from '@/components/blog/components';
import NoteFooter from '@/components/note/footer/index.astro';
import NoteHeader from '@/components/note/note-header.astro';
import { Container } from '@/components/ui/container';
import { Prose } from '@/components/ui/prose';
import NoteLayout from '@/layouts/NoteLayout.astro';
import { getNotes } from '@/lib/collections';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<NoteLayout note={note}>
  <NoteHeader note={note} />
  <Container size="article">
    <Prose as="article" data-pagefind-body data-pagefind-meta={`title:${note.data.title}`}>
      <Content components={components} />
    </Prose>
    <NoteFooter note={note} />
  </Container>
</NoteLayout>

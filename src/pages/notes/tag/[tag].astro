---
import NoteList from '@/components/note/note-list.astro';
import { PageHeader } from '@/components/patterns/page-header';
import { Container } from '@/components/ui/container';
import BaseLayout from '@/layouts/base-layout.astro';
import { getEntries, getTags } from '@/lib/collections';

export async function getStaticPaths() {
  return (await getTags('note')).map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const notes = (await getEntries('note')).filter((note) => note.data.tags.includes(tag));

const title = `Notes tagged "${tag}"`;
const description = `Collection of notes tagged with "${tag}".`;
---

<BaseLayout title={title} description={description}>
  <Container size="article" class="space-y-12 py-8">
    <PageHeader title={title} description={description} />
    <NoteList notes={notes} empty="No notes found with this tag." />
  </Container>
</BaseLayout>

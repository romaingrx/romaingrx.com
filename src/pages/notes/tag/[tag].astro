---
import { createRoute } from 'astro-typesafe-routes/create-route';
import NoteCard from '@/components/note/card/index.astro';
import Shell from '@/components/Shell.astro';
import { routes } from '@/configs/routes';
import { formatTaxonomyLabel } from '@/lib/format';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotes } from '@/lib/collections';

type Props = {
  tag: string;
  notes: Awaited<ReturnType<typeof getNotes>>;
};

export const Route = createRoute({ routeId: '/notes/tag/[tag]' });

export const getStaticPaths = Route.createGetStaticPaths<Props>(async () => {
  const notes = await getNotes();
  const tags = [...new Set(notes.flatMap((note) => note.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      notes: notes.filter((note) => note.data.tags.includes(tag)),
    },
  }));
});

const { tag, notes } = Astro.props;

const label = formatTaxonomyLabel(tag);
const title = `Notes tagged “${label}”`;
const description = `Notes filed under ${label}.`;
---

<BaseLayout title={title} description={description}>
  <Shell type="article">
    <div class="space-y-10 py-8">
      <div class="space-y-4">
        <h1 class="text-4xl font-bold tracking-tight">
          {title}
        </h1>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="text-muted-foreground text-lg">
            {description}
          </p>
          <a class="text-primary underline-offset-4 hover:underline" href={routes.notes}>
            All notes
          </a>
        </div>
      </div>

      {
        notes.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2">
            {notes.map((note) => (
              <NoteCard note={note} />
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground">No notes found with this tag.</p>
        )
      }
    </div>
  </Shell>
</BaseLayout>

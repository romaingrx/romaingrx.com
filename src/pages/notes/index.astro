---
import NoteCard from '@/components/note/card/index.astro';
import Shell from '@/components/Shell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotes } from '@/lib/collections';

const notes = await getNotes();

const title = 'Notes';
const description = 'Short notes on things I learn, build, and find useful.';
---

<BaseLayout title={title} description={description}>
  <Shell type="article">
    <div class="space-y-10 py-8">
      <div class="space-y-4">
        <h1 class="text-4xl font-bold tracking-tight">Notes</h1>
        <p class="text-muted-foreground text-xl">
          {description}
        </p>
      </div>

      {
        notes.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2">
            {notes.map((note) => (
              <NoteCard note={note} />
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground">No notes found.</p>
        )
      }
    </div>
  </Shell>
</BaseLayout>

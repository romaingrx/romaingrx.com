---
import DesignFixture from '@/fixtures/design.astro';
import EmptyDiscoveryFixture from '@/fixtures/discovery-empty.astro';
import SingleDiscoveryFixture from '@/fixtures/discovery-single.astro';

/**
 * Keep the component fixture available in the development server while
 * preventing it from producing a production route, search result, or sitemap
 * entry.
 */
export const prerender = true;

export function getStaticPaths() {
  return import.meta.env.PROD
    ? []
    : [
        { params: { path: undefined } },
        { params: { path: 'discovery' } },
        { params: { path: 'discovery-single' } },
      ];
}
---

{
  Astro.params.path === 'discovery' ? (
    <EmptyDiscoveryFixture />
  ) : Astro.params.path === 'discovery-single' ? (
    <SingleDiscoveryFixture />
  ) : (
    <DesignFixture />
  )
}

---
import BlogListLayout from '@/layouts/blog-list-layout.astro';
import { getCategories, getEntries } from '@/lib/collections';

export async function getStaticPaths() {
  return (await getCategories()).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const posts = (await getEntries('blog')).filter((post) => post.data.categories.includes(category));
---

<BlogListLayout
  title="Blog"
  description={`Blog posts in the ${category} category.`}
  posts={posts}
  activeCategory={category}
/>

---
import { createRoute } from 'astro-typesafe-routes/create-route';
import BlogListLayout from '@/components/blog/blog-list-layout.astro';
import { getBlogPosts } from '@/lib/collections';

type Props = { category: string };

export const Route = createRoute({ routeId: '/blog/category/[category]' });

export const getStaticPaths = Route.createGetStaticPaths<Props>(async () => {
  const posts = await getBlogPosts();
  const categories = [...new Set(posts.flatMap((post) => post.data.categories))];
  return categories.map((category) => ({
    params: { category },
    props: { category },
  }));
});

const { category } = Astro.props;
const allPosts = await getBlogPosts();
const posts = allPosts.filter((post) => post.data.categories.includes(category));
const categories = [...new Set(allPosts.flatMap((post) => post.data.categories))];
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
---

<BlogListLayout
  title="Blog"
  description={`Blog posts in the ${category} category.`}
  posts={posts}
  categories={categories}
  tags={tags}
  activeCategory={category}
/>

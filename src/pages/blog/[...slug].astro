---
import { render } from 'astro:content';
import PostHeader from '@/components/blog/post-header.astro';
import TableOfContents from '@/components/blog/toc.astro';
import EntryFooter from '@/components/entry/entry-footer.astro';
import { components } from '@/components/mdx';
import { Container } from '@/components/ui/container';
import { Prose } from '@/components/ui/prose';
import EntryLayout from '@/layouts/entry-layout.astro';
import { getEntries, type BlogPost } from '@/lib/collections';

export async function getStaticPaths() {
  return (await getEntries('blog')).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: BlogPost };

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<EntryLayout entry={post}>
  <PostHeader post={post} />
  <div class="mt-10"></div>
  <TableOfContents headings={headings} />
  <Container size="article">
    <Prose as="article" data-pagefind-body data-pagefind-meta={`title:${post.data.title}`}>
      <Content components={components} />
    </Prose>
    <EntryFooter entry={post} />
  </Container>
</EntryLayout>

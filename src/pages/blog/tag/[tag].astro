---
import { createRoute } from 'astro-typesafe-routes/create-route';
import BlogListLayout from '@/components/blog/blog-list-layout.astro';
import { getBlogPosts, type BlogPostWithAuthors } from '@/lib/collections';

type Props = {
  tag: string;
  posts: BlogPostWithAuthors[];
  allPosts: BlogPostWithAuthors[];
  categories: string[];
  tags: string[];
};

export const Route = createRoute({ routeId: '/blog/tag/[tag]' });

export const getStaticPaths = Route.createGetStaticPaths<Props>(async () => {
  const posts = await getBlogPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  const categories = [...new Set(posts.flatMap((post) => post.data.categories))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
      allPosts: posts,
      categories,
      tags,
    },
  }));
});

const { tag, posts, allPosts, categories, tags } = Astro.props;
---

<BlogListLayout
  title="Blog"
  description={`Blog posts tagged with ${tag}.`}
  posts={posts}
  allPosts={allPosts}
  categories={categories}
  tags={tags}
  activeTag={tag}
/>

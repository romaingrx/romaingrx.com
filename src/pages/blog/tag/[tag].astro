---
import { createRoute } from 'astro-typesafe-routes/create-route';
import BlogListLayout from '@/components/blog/blog-list-layout.astro';
import { getBlogPosts } from '@/lib/collections';

type Props = { tag: string };

export const Route = createRoute({ routeId: '/blog/tag/[tag]' });

export const getStaticPaths = Route.createGetStaticPaths<Props>(async () => {
  const posts = await getBlogPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
});

const { tag } = Astro.props;
const allPosts = await getBlogPosts();
const posts = allPosts.filter((post) => post.data.tags.includes(tag));
const categories = [...new Set(allPosts.flatMap((post) => post.data.categories))];
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
---

<BlogListLayout
  title="Blog"
  description={`Blog posts tagged with ${tag}.`}
  posts={posts}
  allPosts={allPosts}
  categories={categories}
  tags={tags}
  activeTag={tag}
/>

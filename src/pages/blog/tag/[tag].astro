---
import BlogListLayout from '@/layouts/blog-list-layout.astro';
import { getEntries, getTags } from '@/lib/collections';

export async function getStaticPaths() {
  return (await getTags('blog')).map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getEntries('blog')).filter((post) => post.data.tags.includes(tag));
---

<BlogListLayout title="Blog" description={`Blog posts tagged with ${tag}.`} posts={posts} activeTag={tag} />

---
import HeroSection from '@/components/home/hero.astro';
import RecentNotes from '@/components/home/recent-notes.astro';
import RecentPosts from '@/components/home/recent-posts.astro';
import { Container } from '@/components/ui/container';
import { site } from '@/configs/site';
import BaseLayout from '@/layouts/base-layout.astro';
import { getEntries } from '@/lib/collections';

const posts = (await getEntries('blog')).slice(0, 4);
const notes = (await getEntries('note')).slice(0, 5);
---

<BaseLayout title={site.title} description={site.description}>
  <HeroSection title={`Hi, I'm ${site.name}`} description={site.description} />
  <Container size="content" class="pb-24">
    <RecentPosts posts={posts} />
    <hr class="my-16 border-border/50" />
    <RecentNotes notes={notes} />
  </Container>
</BaseLayout>

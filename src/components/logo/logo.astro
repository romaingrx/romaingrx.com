---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';
import { CELLS } from './mark';

type Props = HTMLAttributes<'svg'>;

const { class: className, ...props } = Astro.props;
---

<svg
  data-slot="logo"
  viewBox="0 0 20 28"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Romain Graux"
  class={cn('h-7 w-auto fill-current', className)}
  {...props}
>
  {
    CELLS.map(({ col, row, accent }) => (
      <circle
        cx={col * 4 + 2}
        cy={row * 4 + 2}
        r="1.8"
        class={accent ? 'fill-accent dark:fill-primary' : undefined}
      />
    ))
  }
</svg>

---
import { cva, type VariantProps } from 'class-variance-authority';

const container = cva(['page-gutter', 'mx-auto'], {
  variants: {
    type: {
      article: ['max-w-article'],
      page: ['max-w-page'],
    },
  },
  defaultVariants: {
    type: 'page',
  },
});

type Props = {
  type: VariantProps<typeof container>['type'];
};

const { type } = Astro.props;
---

<div class={container({ type })}>
  <slot />
</div>

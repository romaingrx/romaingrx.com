---
import { Icon } from 'astro-icon/components';
import DiscussOn from '@/components/blog/discuss-on.astro';
import Resources from '@/components/blog/resources/index.astro';
import TagBadge from '@/components/blog/tag-badge.astro';
import Comments from '@/components/comments.astro';
import { resolveResourceValue } from '@/configs/resources';
import type { NoteWithAuthors } from '@/lib/collections';
import { formatDate } from '@/lib/format';
import { Heading } from '@/components/ui/text';
import RelatedNotes from './related-notes.astro';

interface Props {
  note: NoteWithAuthors;
}

const { note } = Astro.props;
const { tags, updated_date } = note.data;
const resources = note.data.resources.map((r) =>
  Object.assign({}, r, { value: resolveResourceValue(r.value, { collection: 'note', entryId: note.id }) })
);
---

<footer class="mt-16 flex flex-col gap-8">
  <hr />

  <!-- Thank You & Discuss Section -->
  <DiscussOn post={note} />
  {
    resources.length + tags.length > 0 && (
  <div class="rounded-lg border bg-card p-6 text-card-foreground shadow-sm">
    <div class="space-y-6">
      <!-- Tags and Resources -->
      <div class="space-y-4">
        {
          resources.length > 0 && (
            <div class="space-y-3">
              <Heading level={3} size="label" class="font-medium text-muted-foreground">Resources</Heading>
              <Resources resources={resources} />
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="space-y-3">
              <Heading level={3} size="label" class="font-medium text-muted-foreground">Tags</Heading>
              <div class="flex flex-wrap gap-2">
                {note.data.tags.map((tag) => (
                  <TagBadge tag={tag} basePath="/notes" />
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- Update Information -->
      {
        updated_date && (
          <div class="text-muted-foreground flex items-center gap-2 text-sm">
            <Icon name="mdi:calendar-clock" class="size-4" />
            <span>Last updated on {formatDate(updated_date)}</span>
          </div>
        )
      }
    </div>
  </div>
    )
  }

  <!-- Related Content Section -->
  <div class="mb-16">
    <Heading level={2} class="mb-6">More Notes</Heading>
    <RelatedNotes note={note} />
  </div>

  <!-- Comments Section -->
  <div class="my-8">
    <Comments />
  </div>
</footer>

---
import { Card } from '@/components/ui/card';
import { Text } from '@/components/ui/text';
import { Time } from '@/components/ui/time';
import type { Note } from '@/lib/collections';
import NoteHoverCard from './note-hover-card.astro';

/** Notes as compact rows, each previewing its note on hover. */
interface Props {
  notes: Note[];
  empty?: string;
}

const { notes, empty = 'No notes found.' } = Astro.props;
---

{
  notes.length > 0 ? (
    <ul class="space-y-2">
      {notes.map((note) => (
        <Card as="li" class="group block rounded-lg py-0 text-inherit shadow-none transition-colors hover:bg-accent/40">
          <NoteHoverCard note={note}>
            <span class="font-medium transition-colors group-hover:text-primary">
              {note.data.title}
            </span>
            <Time date={note.data.published_date} class="text-sm" />
          </NoteHoverCard>
        </Card>
      ))}
    </ul>
  ) : (
    <Text tone="muted" class="text-center">
      {empty}
    </Text>
  )
}

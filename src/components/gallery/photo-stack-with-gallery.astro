---
import Gallery from './gallery.astro';
import PhotoStack from './photostack.astro';
import type { ImageItem } from './types';

interface Props {
  id?: string;
  images: ImageItem[];
  size?: 'sm' | 'md' | 'lg';
  startIndex?: number;
  showCaptions?: boolean;
}

const {
  id = `gallery-${Math.random().toString(36).substring(2, 11)}`,
  images,
  size = 'md',
  startIndex = 0,
  showCaptions = false,
} = Astro.props;
const dialogId = `${id}-dialog`;
---

<astro-photo-stack-gallery id={id} class="contents">
  <PhotoStack images={images} size={size} dialogId={dialogId} />

  {
    images.length > 0 && (
      <dialog
        id={dialogId}
        aria-label="Photo gallery"
        data-gallery-dialog
        data-pagefind-ignore
        class="gallery-dialog fixed inset-0 m-0 h-dvh max-h-dvh w-screen max-w-none overflow-hidden border-0 bg-black p-0 text-white shadow-none backdrop:bg-black/80"
      >
        <Gallery
          images={images}
          startIndex={startIndex}
          showCaptions={showCaptions}
          showCloseButton
          className="h-full w-full"
        />
      </dialog>
    )
  }
</astro-photo-stack-gallery>

<script>
  import { enableBackdropDismissal, showModal } from '@/lib/dialog';

  class AstroPhotoStackGallery extends HTMLElement {
    private abortController: AbortController | null = null;

    connectedCallback() {
      this.disconnectedCallback();
      this.abortController = new AbortController();
      const { signal } = this.abortController;
      const opener = this.querySelector<HTMLButtonElement>('[data-gallery-opener]');
      const dialog = this.querySelector<HTMLDialogElement>('dialog[data-gallery-dialog]');
      if (!opener || !dialog) return;

      enableBackdropDismissal(dialog, signal);
      opener.addEventListener('click', () => showModal(dialog, opener), { signal });
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
    }
  }

  if (!customElements.get('astro-photo-stack-gallery')) {
    customElements.define('astro-photo-stack-gallery', AstroPhotoStackGallery);
  }
</script>

---
import { Image } from 'astro:assets';
import Button from '@/components/ui/button.astro';
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '@/lib/utils';
import type { ImageItem } from './types';

const MAX_IMAGES_TO_SHOW = 4;

const photoStackVariants = cva('relative cursor-pointer select-none group', {
  variants: {
    size: {
      sm: 'size-32 m-8 sm:m-12',
      md: 'size-40 m-8 sm:m-12',
      lg: 'size-48 m-8 sm:m-12',
    },
  },
  defaultVariants: {
    size: 'md',
  },
});

export type PhotoStackSize = NonNullable<VariantProps<typeof photoStackVariants>['size']>;

interface Props {
  images: ImageItem[];
  dialogId: string;
  size?: PhotoStackSize;
  className?: string;
}

const { images, dialogId, size = 'md', className } = Astro.props;
const displayImages = images.slice(0, MAX_IMAGES_TO_SHOW);

function getStackStyles(index: number, total: number) {
  const rotations = [1, 3, 5, 7];
  const offsets = [
    { x: 0, y: 0 },
    { x: 16, y: -12 },
    { x: -8, y: -24 },
    { x: 24, y: -36 },
  ];
  const factor = size === 'sm' ? 0.5 : size === 'md' ? 1 : 1.5;
  const offset = offsets[total - 1 - index] ?? { x: 0, y: 0 };

  return {
    transform: `rotate(${rotations[index] ?? 0}deg) translate(${offset.x * factor}px, ${offset.y * factor}px)`,
    zIndex: total - index,
  };
}
---

{
  images.length > 0 ? (
    <Button
      type="button"
      variant="ghost"
      aria-label={`Open photo gallery, ${images.length} ${images.length === 1 ? 'photo' : 'photos'}`}
      aria-controls={dialogId}
      aria-haspopup="dialog"
      className={cn(photoStackVariants({ size, className }), 'min-h-0 rounded-md p-0')}
      data-gallery-opener
    >
      <span class="photo-stack-art relative block" aria-hidden="true">
        {displayImages.map((image, index) => {
          const stackStyles = getStackStyles(index, displayImages.length);
          return (
            <span
              class="absolute inset-0"
              style={{
                transform: stackStyles.transform,
                zIndex: stackStyles.zIndex,
              }}
            >
              <Image
                src={image.src}
                alt=""
                class="shadow-3xl relative h-full w-full overflow-hidden rounded-md object-cover"
                loading="lazy"
              />
            </span>
          );
        })}
        <span class="absolute inset-0" />
      </span>
    </Button>
  ) : (
    <p class="text-muted-foreground m-4 text-sm" role="status">
      No photos available.
    </p>
  )
}

<style>
  .photo-stack-art {
    width: 100%;
    height: 100%;
  }

  .group:hover {
    transform: translateY(-4px);
    transition: transform 300ms ease-out;
  }
</style>

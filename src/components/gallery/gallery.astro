---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { Button } from '@/components/ui';
import { cn } from '@/lib/utils';
import type { ImageItem } from './types';

interface Props {
  images: ImageItem[];
  startIndex?: number;
  showCaptions?: boolean;
  showCloseButton?: boolean;
  className?: string;
}

const {
  images,
  startIndex = 0,
  showCaptions = false,
  showCloseButton = false,
  className,
} = Astro.props;
const requestedIndex = Number.isFinite(startIndex) ? Math.trunc(startIndex) : 0;
const initialIndex =
  images.length === 0 ? 0 : Math.max(0, Math.min(requestedIndex, images.length - 1));
const hasMultipleImages = images.length > 1;
---

<astro-gallery
  data-start-index={initialIndex}
  class={cn('gallery flex h-full min-h-0 w-full flex-col bg-black text-white', className)}
>
  {
    showCloseButton && (
      <div class="gallery-toolbar flex shrink-0 justify-end px-3 sm:px-5">
        <Button
          variant="ghost"
          size="icon"
          className="gallery-control gallery-close bg-white/15 text-white hover:bg-white/25 hover:text-white focus-visible:outline-white"
          aria-label="Close gallery"
        >
          <Icon name="lucide:x" class="size-6" />
        </Button>
      </div>
    )
  }

  <div
    class="gallery-stage relative flex min-h-0 flex-1 items-center justify-center overflow-hidden px-3 sm:px-16"
  >
    {
      images.map((image, index) => (
        <div
          class="gallery-image absolute inset-0 flex items-center justify-center"
          data-index={index}
          hidden={index !== initialIndex}
        >
          <Image
            src={image.src}
            alt={image.alt}
            class="h-full w-full object-contain"
            loading={index === initialIndex ? 'eager' : 'lazy'}
          />
        </div>
      ))
    }

    {
      images.length === 0 && (
        <p class="gallery-empty text-center text-white">No images in this gallery.</p>
      )
    }

    <div
      class="gallery-loading pointer-events-none absolute inset-0 flex items-center justify-center bg-black/45"
      role="status"
      hidden={images.length === 0}
    >
      <span class="sr-only">Loading image</span>
      <span
        class="size-8 animate-spin rounded-full border-2 border-white/35 border-t-white"
        aria-hidden="true"></span>
    </div>
    <p
      class="gallery-error absolute inset-x-4 bottom-4 rounded bg-black/85 p-3 text-center text-sm text-white"
      role="status"
      hidden
    >
      This image could not be loaded.
    </p>

    <Button
      variant="ghost"
      size="icon"
      className="gallery-control gallery-prev absolute top-1/2 left-2 -translate-y-1/2 bg-black/75 text-white hover:bg-black/90 hover:text-white focus-visible:outline-white sm:left-4"
      aria-label="Previous image"
      hidden={!hasMultipleImages}
    >
      <Icon name="lucide:chevron-left" class="size-7" />
    </Button>
    <Button
      variant="ghost"
      size="icon"
      className="gallery-control gallery-next absolute top-1/2 right-2 -translate-y-1/2 bg-black/75 text-white hover:bg-black/90 hover:text-white focus-visible:outline-white sm:right-4"
      aria-label="Next image"
      hidden={!hasMultipleImages}
    >
      <Icon name="lucide:chevron-right" class="size-7" />
    </Button>
  </div>

  <div class="gallery-footer flex shrink-0 flex-col items-center gap-2 px-3 sm:gap-3">
    {
      showCaptions && (
        <div class="gallery-captions max-w-[90vw] text-center text-sm text-white sm:text-base">
          {images.map((image, index) => (
            <p class="gallery-caption" data-index={index} hidden={index !== initialIndex}>
              {image.caption || image.alt}
            </p>
          ))}
        </div>
      )
    }
    <p
      class="gallery-counter rounded-full bg-black/85 px-4 py-2 text-sm font-medium text-white"
      role="status"
      aria-live="polite"
      hidden={images.length === 0}
    >
      Photo {initialIndex + 1} of {images.length}
    </p>
  </div>
</astro-gallery>

<script>
  class AstroGallery extends HTMLElement {
    private abortController: AbortController | null = null;
    private currentIndex = 0;
    private images: HTMLElement[] = [];
    private captions: HTMLElement[] = [];
    private loading: HTMLElement | null = null;
    private error: HTMLElement | null = null;
    private counter: HTMLElement | null = null;
    private gestureStart: { x: number; y: number } | null = null;

    connectedCallback() {
      this.disconnectedCallback();
      this.abortController = new AbortController();
      const { signal } = this.abortController;
      this.images = Array.from(this.querySelectorAll<HTMLElement>('.gallery-image'));
      this.captions = Array.from(this.querySelectorAll<HTMLElement>('.gallery-caption'));
      this.loading = this.querySelector<HTMLElement>('.gallery-loading');
      this.error = this.querySelector<HTMLElement>('.gallery-error');
      this.counter = this.querySelector<HTMLElement>('.gallery-counter');
      const requestedIndex = Number.parseInt(this.dataset.startIndex ?? '0', 10);
      this.currentIndex = this.clampIndex(Number.isFinite(requestedIndex) ? requestedIndex : 0);

      this.querySelector<HTMLButtonElement>('.gallery-prev')?.addEventListener(
        'click',
        () => this.prev(),
        {
          signal,
        }
      );
      this.querySelector<HTMLButtonElement>('.gallery-next')?.addEventListener(
        'click',
        () => this.next(),
        {
          signal,
        }
      );
      this.querySelector<HTMLButtonElement>('.gallery-close')?.addEventListener(
        'click',
        () => {
          this.closest('dialog')?.close();
        },
        { signal }
      );
      this.addEventListener(
        'keydown',
        (event: KeyboardEvent) => {
          if (event.key === 'ArrowLeft' && this.images.length > 1) {
            event.preventDefault();
            this.prev();
          } else if (event.key === 'ArrowRight' && this.images.length > 1) {
            event.preventDefault();
            this.next();
          }
        },
        { signal }
      );

      const stage = this.querySelector<HTMLElement>('.gallery-stage');
      stage?.addEventListener(
        'pointerdown',
        (event: PointerEvent) => {
          if (!event.isPrimary) {
            this.gestureStart = null;
            return;
          }
          if (event.target instanceof Element && event.target.closest('button')) return;
          this.gestureStart = { x: event.clientX, y: event.clientY };
        },
        { signal }
      );
      stage?.addEventListener(
        'pointerup',
        (event: PointerEvent) => {
          const start = this.gestureStart;
          this.gestureStart = null;
          if (!start || !event.isPrimary) return;
          const dx = event.clientX - start.x;
          const dy = event.clientY - start.y;
          if (Math.abs(dx) < 50 || Math.abs(dx) <= Math.abs(dy)) return;
          if (dx < 0) this.next();
          else this.prev();
        },
        { signal }
      );
      stage?.addEventListener(
        'pointercancel',
        () => {
          this.gestureStart = null;
        },
        { signal }
      );

      this.images.forEach((container, index) => {
        const image = container.querySelector<HTMLImageElement>('img');
        if (!image) return;
        image.addEventListener('load', () => this.handleImageEvent(index), { signal });
        image.addEventListener('error', () => this.handleImageEvent(index), { signal });
      });

      this.updateDisplay();
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
    }

    private clampIndex(index: number) {
      return this.images.length === 0 ? 0 : Math.max(0, Math.min(index, this.images.length - 1));
    }

    private next() {
      if (this.images.length < 2) return;
      this.currentIndex = (this.currentIndex + 1) % this.images.length;
      this.updateDisplay();
    }

    private prev() {
      if (this.images.length < 2) return;
      this.currentIndex = (this.currentIndex - 1 + this.images.length) % this.images.length;
      this.updateDisplay();
    }

    private handleImageEvent(index: number) {
      if (index === this.currentIndex) this.updateImageStatus();
    }

    private updateDisplay() {
      this.images.forEach((image, index) => {
        image.hidden = index !== this.currentIndex;
      });
      this.captions.forEach((caption, index) => {
        caption.hidden = index !== this.currentIndex;
      });
      if (this.counter) {
        this.counter.textContent = this.images.length
          ? `Photo ${this.currentIndex + 1} of ${this.images.length}`
          : '';
        this.counter.hidden = this.images.length === 0;
      }
      this.updateImageStatus();
    }

    private updateImageStatus() {
      const image = this.images[this.currentIndex]?.querySelector<HTMLImageElement>('img');
      const loaded = Boolean(image?.complete && image.naturalWidth > 0);
      const failed = Boolean(image?.complete && image.naturalWidth === 0);
      if (this.loading) this.loading.hidden = this.images.length === 0 || loaded || failed;
      if (this.error) this.error.hidden = !failed;
    }
  }

  if (!customElements.get('astro-gallery')) customElements.define('astro-gallery', AstroGallery);
</script>

<style>
  .gallery {
    height: 100%;
    min-height: 0;
  }

  .gallery-toolbar {
    padding-block-start: max(0.75rem, env(safe-area-inset-top));
  }

  .gallery-footer {
    padding-block-end: max(0.75rem, env(safe-area-inset-bottom));
  }

  .gallery-control {
    min-height: 44px;
    min-width: 44px;
    height: 44px;
    width: 44px;
    flex: none;
  }

  .gallery-stage {
    touch-action: pan-y pinch-zoom;
  }

  .gallery [hidden] {
    display: none !important;
  }
</style>

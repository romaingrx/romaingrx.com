---
import { Icon } from 'astro-icon/components';
import { Grid } from '@/components/ui/grid';
import { Heading } from '@/components/ui/text';
import { getRelated, type Entry } from '@/lib/collections';
import EntryCard from './entry-card.astro';

interface Props {
  entry: Entry;
}

const related = await getRelated(Astro.props.entry);
const noun = Astro.props.entry.collection === 'blog' ? 'Post' : 'Note';
---

<Heading level={2} class="mb-6">
  {related.kind === 'related' ? 'Related Content' : `More ${noun}s`}
</Heading>
{
  related.kind === 'related' ? (
    <Grid cols={3}>
      {related.entries.map((entry) => (
        <EntryCard entry={entry} />
      ))}
    </Grid>
  ) : (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {related.previous && (
        <div>
          <div class="text-muted-foreground mb-2 flex items-center gap-2 text-sm">
            <Icon name="lucide:arrow-left" class="size-4" />
            <span>Previous {noun}</span>
          </div>
          <EntryCard entry={related.previous} />
        </div>
      )}
      {related.next && (
        <div>
          <div class="text-muted-foreground mb-2 flex items-center justify-end gap-2 text-sm">
            <span>Next {noun}</span>
            <Icon name="lucide:arrow-right" class="size-4" />
          </div>
          <EntryCard entry={related.next} />
        </div>
      )}
    </div>
  )
}

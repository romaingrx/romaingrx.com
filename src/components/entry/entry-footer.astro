---
import { Icon } from 'astro-icon/components';
import { Card } from '@/components/ui/card';
import { Heading } from '@/components/ui/text';
import { routes } from '@/configs/routes';
import { tagPath, type Entry } from '@/lib/collections';
import { formatDate } from '@/lib/format';
import Comments from './comments.astro';
import DiscussOn from './discuss-on.astro';
import RelatedEntries from './related-entries.astro';
import ResourceList from './resource-list.astro';
import TaxonomyBadge from './taxonomy-badge.astro';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { tags, updated_date } = entry.data;
const categories = 'categories' in entry.data ? entry.data.categories : [];
const hasMetadata = [entry.resources.length, tags.length, categories.length, updated_date].some(Boolean);
---

<footer class="mt-16 flex flex-col gap-8">
  <hr />

  <DiscussOn entry={entry} />

  {
    hasMetadata && (
      <Card class="block rounded-lg p-6">
        <div class="space-y-6">
          <div class="space-y-4">
            {entry.resources.length > 0 && (
              <div class="space-y-3">
                <Heading level={3} size="label" class="font-medium text-muted-foreground">
                  Resources
                </Heading>
                <ResourceList resources={entry.resources} />
              </div>
            )}
            {tags.length > 0 && (
              <div class="space-y-3">
                <Heading level={3} size="label" class="font-medium text-muted-foreground">
                  Tags
                </Heading>
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <TaxonomyBadge kind="tag" label={tag} href={tagPath(entry.collection, tag)} />
                  ))}
                </div>
              </div>
            )}
            {categories.length > 0 && (
              <div class="space-y-3">
                <Heading level={3} size="label" class="font-medium text-muted-foreground">
                  Categories
                </Heading>
                <div class="flex flex-wrap gap-2">
                  {categories.map((category) => (
                    <TaxonomyBadge kind="category" label={category} href={routes.blogCategory(category)} />
                  ))}
                </div>
              </div>
            )}
          </div>
          {updated_date && (
            <div class="text-muted-foreground flex items-center gap-2 text-sm">
              <Icon name="mdi:calendar-clock" class="size-4" />
              <span>Last updated on {formatDate(updated_date)}</span>
            </div>
          )}
        </div>
      </Card>
    )
  }

  <div class="mb-16">
    <RelatedEntries entry={entry} />
  </div>

  <div class="my-8">
    <Comments />
  </div>
</footer>

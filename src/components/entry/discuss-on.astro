---
import { Icon } from 'astro-icon/components';
import { Button } from '@/components/ui/button';
import { Heading, Text } from '@/components/ui/text';
import type { Entry } from '@/lib/collections';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;

const threads = [
  entry.data.x_thread_id && {
    label: 'X',
    url: entry.data.x_thread_id,
    icon: 'simple-icons:x',
  },
  entry.data.bsky_thread_id && {
    label: 'Bluesky',
    url: entry.data.bsky_thread_id,
    icon: 'simple-icons:bluesky',
  },
].filter(Boolean) as { label: string; url: string; icon: string }[];
---

<div class="flex flex-col items-center justify-center space-y-4 text-center">
  <Heading level={2}>Thank you for reading!</Heading>
  <Text tone="muted">
    {
      threads.length > 0
        ? 'Enjoyed this post? Join the conversation or share it with others.'
        : 'If you found this helpful, feel free to share it with others.'
    }
  </Text>
  {
    threads.length > 0 && (
      <div class="flex flex-row gap-2 pt-1">
        {threads.map((thread) => (
          <Button
            href={thread.url}
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            size="sm"
            aria-label={`Discuss on ${thread.label}`}
          >
            <Icon name={thread.icon} />
            {thread.label}
          </Button>
        ))}
      </div>
    )
  }
</div>

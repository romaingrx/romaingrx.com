---
import type { Resource } from '@/configs/resources';
import ResourceBadge from './resource-badge.astro';

interface Props {
  resources: Resource[];
}

const { resources } = Astro.props;
---

{
  resources.length > 0 && (
    <div class="flex flex-wrap items-start justify-start gap-3">
      {resources.map((resource) => (
        <ResourceBadge {...resource} />
      ))}
    </div>
  )
}

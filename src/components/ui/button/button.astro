---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';
import { buttonVariants, type ButtonVariants } from './variants';

type Props = ButtonVariants &
  (
    | ({ href: string } & HTMLAttributes<'a'>)
    | ({ href?: undefined } & HTMLAttributes<'button'>)
  );

const { variant, size, class: className, href, ...props } = Astro.props;
const classes = cn(buttonVariants({ variant, size }), className);
---

{
  href ? (
    <a data-slot="button" href={href} class={classes} {...(props as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button data-slot="button" type="button" class={classes} {...(props as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}

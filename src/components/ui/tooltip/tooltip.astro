---
import { cn } from '@/lib/utils';
import { tooltipVariants, type TooltipVariants } from './variants';

interface Props extends TooltipVariants {
  class?: string;
}

const { side, intent, class: className } = Astro.props;
---

<span data-slot="tooltip" class="group/tooltip relative inline-block">
  <slot name="trigger" />
  <span role="tooltip" class={cn(tooltipVariants({ side, intent }), className)}>
    <slot name="content" />
  </span>
</span>

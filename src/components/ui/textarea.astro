---
import { fieldVariants } from './variants';
import { cn } from '@/lib/utils';

type Props = astroHTML.JSX.TextareaHTMLAttributes & {
  className?: string;
};

const { className, class: cls, value, ...props } = Astro.props;
---

<textarea
  {...props}
  data-slot="textarea"
  class={cn(fieldVariants(), 'min-h-24 resize-y', className, cls)}>{value}</textarea
>

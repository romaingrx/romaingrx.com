---
import type { HTMLAttributes } from 'astro/types';
import { buttonVariants, type AccessibleControlProps, type ButtonVariant } from './variants';
import { cn } from '@/lib/utils';

type BaseProps = Omit<HTMLAttributes<'button'>, 'aria-label' | 'aria-labelledby'> & {
  variant?: ButtonVariant;
  className?: string;
};

type Props = BaseProps & AccessibleControlProps;

const { variant = 'default', size = 'default', className, class: cls, ...props } = Astro.props;
---

<button {...props} data-slot="button" class={cn(buttonVariants({ variant, size }), className, cls)}>
  <slot />
</button>

---
import type { HTMLAttributes } from 'astro/types';
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '@/lib/utils';

const containerVariants = cva('mx-auto w-full px-4 sm:px-6 lg:px-8', {
  variants: {
    size: {
      /** Reading width for articles and notes. */
      article: 'max-w-4xl',
      /** Listings and landing sections. */
      content: 'max-w-5xl',
      /** Full page chrome. */
      page: 'max-w-7xl',
    },
  },
  defaultVariants: {
    size: 'page',
  },
});

type Props = VariantProps<typeof containerVariants> &
  HTMLAttributes<'div'> & {
    as?: 'div' | 'section' | 'main' | 'header' | 'footer';
  };

const { as: Tag = 'div', size, class: className, ...props } = Astro.props;
---

<Tag data-slot="container" class={cn(containerVariants({ size }), className)} {...props}>
  <slot />
</Tag>

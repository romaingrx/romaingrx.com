---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';
import { stackVariants, type StackVariants } from './variants';

type Props = StackVariants &
  HTMLAttributes<'div'> & {
    as?: 'div' | 'section' | 'header' | 'footer' | 'nav' | 'ul' | 'ol' | 'li' | 'span';
  };

const {
  as: Tag = 'div',
  direction,
  gap,
  align,
  justify,
  wrap,
  class: className,
  ...props
} = Astro.props;
---

<Tag
  data-slot="stack"
  class={cn(stackVariants({ direction, gap, align, justify, wrap }), className)}
  {...props}
>
  <slot />
</Tag>

---
import { axis, type AxisConfig } from '@/lib/chart/axis';
import type { ScatterPayload } from '@/lib/chart/payload';
import { r, VIEW } from '@/lib/chart/scale';

import ChartRoot from './chart-root.astro';
import Marker from './marker.astro';
import PlotFrame from './plot-frame.astro';
import PlotSvg from './plot-svg.astro';

export interface ScatterPoint {
  x: number;
  y: number;
  color: string;
  /** Tooltip heading. */
  title: string;
  /** Monospace tooltip body, one colored character at a time when `charColors` is set. */
  detail?: string;
  /** Tooltip footer. */
  note?: string;
}

interface Props {
  points: ScatterPoint[];
  xAxis?: AxisConfig;
  yAxis?: AxisConfig;
  charColors?: Record<string, string>;
  height?: number;
  class?: string;
}

const { points, xAxis = {}, yAxis = {}, charColors = {}, height = 400, class: className } = Astro.props;

const xa = axis(
  points.map((p) => p.x),
  xAxis
);
const ya = axis(
  points.map((p) => p.y),
  yAxis
);
const placed = points.map((p) => ({ p, fx: r(xa.scale.at(p.x)), fy: r(1 - ya.scale.at(p.y)) }));

const payload: ScatterPayload = {
  points: placed.map(({ p, fx, fy }) => [fx, fy, p.color, p.title, p.detail ?? '', p.note ?? '']),
  charColors,
};
---

<ChartRoot kind="scatter" data={payload} class={className}>
  <PlotFrame height={height} x={xa} y={ya}>
    <PlotSvg>
      <g
        stroke-opacity="0.7"
        stroke-width="6"
        stroke-linecap="round"
        class="[&>path]:[vector-effect:non-scaling-stroke]"
      >
        {
          placed.map(({ p, fx, fy }) => (
            // Whole view units keep 500 dots compact; a unit is about a pixel.
            <path d={`M${Math.round(fx * VIEW)} ${Math.round(fy * VIEW)}h0`} stroke={p.color} />
          ))
        }
      </g>
    </PlotSvg>
    <Marker class="size-2.5 ring-foreground" />
  </PlotFrame>
</ChartRoot>

<script>
  import { find, toggle } from './dom';
  import { bindHover } from './hover';
  import { colored, heading, note } from './tooltip';
  import type { ScatterPayload } from '@/lib/chart/payload';

  /** Points snap to the pointer within this many pixels. */
  const SNAP = 12;

  bindHover<ScatterPayload>('scatter', ({ plot, data, tip }) => {
    const marker = find(plot, '[data-marker]');

    return {
      move(p) {
        let best: ScatterPayload['points'][number] | undefined;
        let bestDist = SNAP ** 2;
        for (const point of data.points) {
          const d = ((point[0] - p.x) * p.width) ** 2 + ((point[1] - p.y) * p.height) ** 2;
          if (d < bestDist) [best, bestDist] = [point, d];
        }
        if (!best) {
          toggle(marker, false);
          return tip.hide();
        }

        const [x, y, color, title, detail, footer] = best;
        marker.style.left = `${x * 100}%`;
        marker.style.top = `${y * 100}%`;
        marker.style.background = color;
        toggle(marker, true);

        const content: Node[] = [heading(title)];
        if (detail) content.push(colored(detail, data.charColors));
        if (footer) content.push(note(footer));
        tip.show(content, x, y);
      },
      leave() {
        toggle(marker, false);
      },
    };
  });
</script>

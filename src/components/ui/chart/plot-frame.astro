---
import type { Axis } from '@/lib/chart/axis';
import { pct, toView, VIEW } from '@/lib/chart/scale';

import PlotSvg from './plot-svg.astro';

interface Props {
  x: Axis;
  y: Axis;
  /** Optional right-hand axis. */
  y2?: Axis;
  height: number;
}

const { x, y, y2, height } = Astro.props;

// Axis columns are sized from their longest tick label (12px text is ~7px per character).
const width = (a: Axis) =>
  Math.max(...a.scale.ticks.map((t) => a.format(t).length)) * 7 + 10 + (a.label ? 18 : 0);
const yPos = (a: Axis, t: number) => 1 - a.scale.at(t);
---

<div
  data-slot="chart-frame"
  class="grid"
  style={`grid-template-columns: ${width(y)}px minmax(0, 1fr) ${y2 ? width(y2) : 8}px; grid-template-rows: ${height}px auto;`}
>
  <div class="relative">
    {
      y.label && (
        <span class="absolute top-1/2 left-2 -translate-x-1/2 -translate-y-1/2 -rotate-90 whitespace-nowrap">
          {y.label}
        </span>
      )
    }
    {
      y.scale.ticks.map((t) => (
        <span class="absolute right-2 -translate-y-1/2 tabular-nums" style={`top: ${pct(yPos(y, t))}`}>
          {y.format(t)}
        </span>
      ))
    }
  </div>

  <div data-plot class="relative touch-pan-y">
    <PlotSvg>
      <g class="stroke-border [&>line]:[vector-effect:non-scaling-stroke]" stroke-dasharray="3 3">
        {
          y.scale.ticks.map((t) => {
            const v = toView(yPos(y, t));
            return <line x1="0" x2={VIEW} y1={v} y2={v} />;
          })
        }
        {
          x.scale.ticks.map((t) => {
            const v = toView(x.scale.at(t));
            return <line x1={v} x2={v} y1="0" y2={VIEW} />;
          })
        }
      </g>
    </PlotSvg>
    <slot />
    <div
      data-tip
      role="tooltip"
      class="pointer-events-none absolute z-10 hidden min-w-32 rounded-lg border bg-background px-2.5 py-1.5 text-xs text-foreground shadow-xl"
    >
    </div>
  </div>

  <div class="relative">
    {
      y2?.scale.ticks.map((t) => (
        <span class="absolute left-2 -translate-y-1/2 tabular-nums" style={`top: ${pct(yPos(y2, t))}`}>
          {y2.format(t)}
        </span>
      ))
    }
  </div>

  <div></div>
  <div class="relative h-5">
    {
      x.scale.ticks.map((t) => (
        <span class="absolute top-1.5 -translate-x-1/2 tabular-nums" style={`left: ${pct(x.scale.at(t))}`}>
          {x.format(t)}
        </span>
      ))
    }
  </div>
  <div></div>
</div>
{x.label && <div class="mt-1.5 text-center">{x.label}</div>}

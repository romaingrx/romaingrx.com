---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';
import Button from '@/components/ui/button.astro';
import { cn } from '@/lib/utils';

interface Props extends HTMLAttributes<'dialog'> {
  id: string;
  title?: string;
  description?: string;
  label?: string;
  className?: string;
  hideCloseButton?: true;
}

const { id, title, description, label, className, hideCloseButton = false, ...props } = Astro.props;
---

<dialog
  id={id}
  class={cn('dialog relative w-full', className)}
  aria-label={label}
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-describedby={description ? `${id}-description` : undefined}
  data-astro-dialog
  data-pagefind-ignore
  {...props}
>
  <article>
    {
      (title || description) && (
        <header>
          {title && <h2 id={`${id}-title`}>{title}</h2>}
          {description && <p id={`${id}-description`}>{description}</p>}
        </header>
      )
    }

    <section>
      <slot />
    </section>

    <slot name="footer" />
    {
      !hideCloseButton && (
        <Button
          variant="ghost"
          type="button"
          size="icon"
          aria-label="Close dialog"
          onclick="this.closest('dialog')?.close()"
          className="absolute top-4 right-4 rounded-full"
        >
          <Icon name="lucide:x" class="size-4" />
        </Button>
      )
    }
  </article>
</dialog>

<script>
  import { enableBackdropDismissal } from '@/lib/dialog';

  document
    .querySelectorAll<HTMLDialogElement>('dialog[data-astro-dialog]')
    .forEach(enableBackdropDismissal);
</script>

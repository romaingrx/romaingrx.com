---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';
import Button from '@/components/ui/button.astro';
import { cn } from '@/lib/utils';

interface Props extends HTMLAttributes<'dialog'> {
  id: string;
  title?: string;
  description?: string;
  label?: string;
  className?: string;
  hideCloseButton?: true;
}

const { id, title, description, label, className, hideCloseButton = false, ...props } = Astro.props;
---

<dialog
  id={id}
  class={cn(
    'fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-lg border border-border bg-card p-0 text-card-foreground shadow-xl backdrop:bg-black/60',
    className
  )}
  aria-label={label}
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-describedby={description ? `${id}-description` : undefined}
  data-astro-dialog
  data-pagefind-ignore
  {...props}
>
  <div class="relative space-y-4 p-6">
    {
      (title || description) && (
        <header class="space-y-1 pr-10">
          {title && (
            <h2 id={`${id}-title`} class="text-lg leading-none font-semibold">
              {title}
            </h2>
          )}
          {description && (
            <p id={`${id}-description`} class="text-muted-foreground text-sm">
              {description}
            </p>
          )}
        </header>
      )
    }

    <section class="space-y-4">
      <slot />
    </section>

    <slot name="footer" />
    {
      !hideCloseButton && (
        <form method="dialog" class="absolute top-3 right-3">
          <Button variant="ghost" type="submit" size="icon" aria-label="Close dialog">
            <Icon name="lucide:x" class="size-4" />
          </Button>
        </form>
      )
    }
  </div>
</dialog>

<script>
  import { enableBackdropDismissal } from '@/lib/dialog';

  document
    .querySelectorAll<HTMLDialogElement>('dialog[data-astro-dialog]')
    .forEach((dialog) => enableBackdropDismissal(dialog));
</script>

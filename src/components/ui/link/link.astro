---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';
import { linkVariants, type LinkVariants } from './variants';

type Props = LinkVariants &
  HTMLAttributes<'a'> & {
    href: string;
    /** Open in a new tab. Defaults to true for absolute http(s) URLs. */
    external?: boolean;
  };

const { href, external, variant, class: className, ...props } = Astro.props;
const isExternal = external ?? /^https?:\/\//.test(href);
---

<a
  data-slot="link"
  href={href}
  class={cn(linkVariants({ variant }), className)}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  {...props}
>
  <slot />
</a>

---
import { cn } from '@/lib/utils';

type Props = { class?: string };

const { class: className } = Astro.props;
---

<div
  data-slot="spinner"
  role="status"
  aria-label="Loading"
  class={cn(
    'size-8 animate-spin rounded-full border-2 border-muted-foreground border-t-primary',
    className
  )}
>
</div>

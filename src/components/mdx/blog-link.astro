---
import { getEntry, render } from 'astro:content';
import { HoverCard } from '@/components/ui/hover-card';
import { Stack } from '@/components/ui/stack';
import { Text } from '@/components/ui/text';
import { routes } from '@/configs/routes';
import { formatDate } from '@/lib/format';

/** MDX: an inline link to another post, previewing it on hover. */
interface Props {
  post: string;
}

const { post: postId } = Astro.props;
const entry = await getEntry('blog', postId);
if (!entry) {
  throw new Error(`BlogLink: blog post "${postId}" not found`);
}
const { remarkPluginFrontmatter } = await render(entry);
const readingTime: string | undefined = remarkPluginFrontmatter?.minutesRead;
---

<HoverCard contentClass="w-72">
  <a href={routes.blog({ slug: entry.data.permalink })}>
    {Astro.slots.has('default') ? <slot /> : entry.data.title}
  </a>
  <Stack as="span" gap={1.5} slot="content">
    <Text as="span" size="sm" weight="medium" leading="snug">{entry.data.title}</Text>
    <Text as="span" size="xs" tone="muted" clamp={2}>{entry.data.description}</Text>
    <Stack as="span" direction="row" align="center" gap={2} class="pt-1 text-xs text-muted-foreground">
      <span>{formatDate(entry.data.published_date)}</span>
      {
        readingTime && (
          <>
            <span>·</span>
            <span>{readingTime}</span>
          </>
        )
      }
    </Stack>
  </Stack>
</HoverCard>

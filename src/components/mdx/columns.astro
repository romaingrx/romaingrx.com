---
import { cva, type VariantProps } from 'class-variance-authority';
import { Grid, type GridVariants } from '@/components/ui/grid';
import { cn } from '@/lib/utils';

/** MDX: lay children out side by side from `md` up. */
const spacing = cva('', {
  variants: {
    space: {
      around: 'md:justify-around',
      between: 'md:justify-between',
      evenly: 'md:justify-evenly',
    },
  },
  defaultVariants: {
    space: 'between',
  },
});

interface Props extends VariantProps<typeof spacing> {
  columns?: GridVariants['cols'];
  /** Kept for existing MDX; columns always stretch now. */
  spread?: boolean;
  class?: string;
}

const { columns = 2, space, spread: _spread, class: className, ...rest } = Astro.props;
---

<Grid cols={columns} gap={4} class={cn(spacing({ space }), 'columns', className)} {...rest}>
  <slot />
</Grid>

<style>
  /* Stretch island wrappers so cards fill the column height. */
  .columns :global(> astro-island) {
    display: flex;
    flex-direction: column;
  }
  .columns :global(> astro-island > *) {
    flex: 1;
  }
</style>

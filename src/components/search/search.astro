---
import '@/styles/command.css';
import { Icon } from 'astro-icon/components';
import Button from '@/components/ui/button.astro';
---

<Button
  type="button"
  variant="ghost"
  className="text-muted-foreground hover:text-foreground min-h-11"
  aria-label="Search"
  aria-haspopup="dialog"
  aria-controls="search-dialog"
  id="search-trigger"
>
  <Icon name="lucide:search" class="size-4" />
  <span class="hidden text-xs sm:inline">Search</span>
  <kbd
    id="search-shortcut-hint"
    class="border-border bg-muted text-muted-foreground hidden items-center gap-0.5 rounded border px-1.5 py-0.5 text-[10px] font-medium sm:inline-flex"
    aria-hidden="true">Ctrl+K</kbd
  >
</Button>

<dialog id="search-dialog" class="command-dialog" aria-label="Search posts and notes">
  <div class="search-command">
    <header>
      <Icon name="lucide:search" class="text-muted-foreground size-4 shrink-0" />
      <input
        type="search"
        id="search-input"
        aria-label="Search posts and notes"
        aria-controls="search-items"
        aria-describedby="search-status"
        placeholder="Search posts and notes..."
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <Button
        type="button"
        variant="ghost"
        className="min-h-11 shrink-0"
        id="search-close"
        aria-label="Close search"
      >
        Close
      </Button>
    </header>
    <div id="search-results" class="scrollbar">
      <p id="search-status" class="search-status" role="status" aria-live="polite">
        Type to search across all content.
      </p>
      <div id="search-panel" aria-busy="false">
        <div id="search-spinner" class="search-spinner hidden" aria-hidden="true">
          <Icon name="lucide:loader-2" class="text-muted-foreground size-5 animate-spin" />
        </div>
        <ul id="search-items" class="search-results hidden"></ul>
        <Button
          type="button"
          variant="outline"
          className="mx-auto mt-2 hidden min-h-11"
          id="search-retry"
        >
          Retry
        </Button>
        <Button
          type="button"
          variant="outline"
          className="mx-auto mt-2 hidden min-h-11"
          id="search-more"
        >
          Show more
        </Button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { initializeSearch } from '@/lib/search/controller';

  initializeSearch();
</script>

---
import { cn } from '@/lib/utils';

interface Props {
  /** Chart type, which the matching hover script selects on. */
  kind: string;
  /** Serialized data for the hover script, from `encode()`. */
  payload?: string;
  class?: string;
}

const { kind, payload, class: className } = Astro.props;
---

<div
  data-slot="chart"
  data-chart={kind}
  data-payload={payload}
  class={cn('text-xs text-muted-foreground select-none', className)}
>
  <slot />
</div>

---
import ChartRoot from './parts/chart-root.astro';
import Legend from './parts/legend.astro';
import Marker from './parts/marker.astro';
import PlotFrame from './parts/plot-frame.astro';
import PlotSvg from './parts/plot-svg.astro';
import { axis, fmt, type AxisConfig } from './lib/axis';
import { encode, type LinePayload } from './lib/payload';
import { r, toView } from './lib/scale';

export interface LineSeries {
  label: string;
  /** Any CSS color, usually a `var(--chart-n)` token. */
  color: string;
  values: number[];
  dashed?: boolean;
  /** Plot against the right-hand axis. */
  axis?: 'left' | 'right';
}

interface Props {
  x: number[];
  series: LineSeries[];
  xAxis?: AxisConfig;
  yAxis?: AxisConfig;
  /** Used only when a series sets `axis: 'right'`. */
  y2Axis?: AxisConfig;
  /** Tooltip heading for a point; defaults to the x tick format. */
  tooltipTitle?: (x: number) => string;
  legend?: boolean;
  height?: number;
  class?: string;
}

const {
  x,
  series,
  xAxis = {},
  yAxis = {},
  y2Axis = {},
  tooltipTitle,
  legend = series.length > 1,
  height = 300,
  class: className,
} = Astro.props;

const onRight = (s: LineSeries) => s.axis === 'right';
const valuesOf = (list: LineSeries[]) => list.flatMap((s) => s.values);
const right = series.filter(onRight);

const xa = axis(x, { ...xAxis, domain: xAxis.domain ?? [x[0], x[x.length - 1]] });
const ya = axis(valuesOf(series.filter((s) => !onRight(s))), yAxis);
const y2a = right.length ? axis(valuesOf(right), y2Axis) : undefined;
const xf = x.map((v) => r(xa.scale.at(v)));

const plotted = series.map((s) => {
  const { scale } = onRight(s) && y2a ? y2a : ya;
  const y = s.values.map((v) => r(1 - scale.at(v)));
  return { s, y, points: y.map((fy, i) => `${toView(xf[i])},${toView(fy)}`).join(' ') };
});

const payload: LinePayload = {
  titles: x.map(tooltipTitle ?? xa.format),
  x: xf,
  // Tooltips show more precision than the axis ticks.
  series: plotted.map(({ s, y }) => ({ label: s.label, color: s.color, values: s.values.map(fmt), y })),
};
---

<ChartRoot kind="line" payload={encode(payload)} class={className}>
  <PlotFrame height={height} x={xa} y={ya} y2={y2a}>
    <PlotSvg>
      {
        plotted.map(({ s, points }) => (
          <polyline
            points={points}
            fill="none"
            stroke={s.color}
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
            stroke-dasharray={s.dashed ? '5 5' : undefined}
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </PlotSvg>
    <div data-cursor class="pointer-events-none absolute inset-y-0 hidden w-px bg-border"></div>
    {series.map((s) => <Marker color={s.color} />)}
  </PlotFrame>
  {legend && <Legend items={series} />}
</ChartRoot>

<script>
  import { bindHover } from './client/hover';
  import { heading, row, toggle } from './client/tooltip';
  import type { LinePayload } from './lib/payload';

  /** Index of the sorted position closest to `f`. */
  function nearest(xs: number[], f: number) {
    let lo = 0;
    let hi = xs.length - 1;
    while (hi - lo > 1) {
      const mid = (lo + hi) >> 1;
      if (xs[mid] < f) lo = mid;
      else hi = mid;
    }
    return f - xs[lo] < xs[hi] - f ? lo : hi;
  }

  bindHover<LinePayload>('line', ({ plot, data, tip }) => {
    const cursor = plot.querySelector<HTMLElement>('[data-cursor]')!;
    const markers = [...plot.querySelectorAll<HTMLElement>('[data-marker]')];
    const overlays = [cursor, ...markers];

    return {
      move(p) {
        const i = nearest(data.x, p.x / p.width);
        const left = `${data.x[i] * 100}%`;
        cursor.style.left = left;
        markers.forEach((m, k) => {
          m.style.left = left;
          m.style.top = `${data.series[k].y[i] * 100}%`;
        });
        overlays.forEach((o) => toggle(o, true));
        tip.show(
          [heading(data.titles[i]), ...data.series.map((s) => row(s.color, s.label, s.values[i]))],
          data.x[i],
          p.y
        );
      },
      leave() {
        overlays.forEach((o) => toggle(o, false));
      },
    };
  });
</script>

---
interface Props {
  items: { label: string; color: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-wrap items-center justify-center gap-4 pt-3 text-foreground">
  {
    items.map((item) => (
      <div class="flex items-center gap-1.5">
        <span class="size-2 shrink-0 rounded-[2px]" style={`background: ${item.color}`} />
        {item.label}
      </div>
    ))
  }
</div>

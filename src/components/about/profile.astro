---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { SocialLinks } from '@/components/patterns/social-links';
import { Heading } from '@/components/ui/text';
import { getAuthorSocialLinks } from '@/lib/authors';

interface Props {
  author: string;
}

const author = await getEntry('author', Astro.props.author);
if (!author) {
  throw new Error('Author not found for owner of the website');
}
const { name, image } = author.data;
const socialLinks = getAuthorSocialLinks(author);
---

<section class="rounded-2xl border border-border/60 bg-card/30 p-6 sm:p-8">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
    <div class="size-32 shrink-0 overflow-hidden rounded-2xl sm:size-40">
      <Image
        src={image}
        alt={name}
        width={160}
        height={160}
        densities={[1, 2]}
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex flex-col gap-4">
      <Heading level={1}>{name}</Heading>
      {socialLinks.length > 0 && <SocialLinks links={socialLinks} variant="boxed" iconClass="size-4" />}
    </div>
  </div>
</section>

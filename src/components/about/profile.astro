---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { SocialLinks } from '@/components/patterns/social-links';
import { Heading } from '@/components/ui/text';
import { getAuthorSocialLinks } from '@/lib/authors';

interface Props {
  author: string;
}

const author = await getEntry('author', Astro.props.author);
if (!author) {
  throw new Error('Author not found for owner of the website');
}
const { name, image } = author.data;
const socialLinks = getAuthorSocialLinks(author);
---

<section class="flex items-center gap-5">
  <Image
    src={image}
    alt={name}
    width={80}
    height={80}
    densities={[1, 2]}
    class="size-20 shrink-0 rounded-xl object-cover"
  />
  <div class="flex flex-col gap-2">
    <Heading level={1} size="page">{name}</Heading>
    {socialLinks.length > 0 && <SocialLinks links={socialLinks} iconClass="size-4" />}
  </div>
</section>

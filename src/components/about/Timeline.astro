---
import { getCollection, type CollectionEntry } from 'astro:content';

import { Link } from '@/components/ui/link';
import { Stack } from '@/components/ui/stack';
import { Heading, Text } from '@/components/ui/text';
import { formatPeriod } from '@/lib/format';

type Entry = CollectionEntry<'timeline'>;

const groups = [
  { type: 'experience', title: 'Work' },
  { type: 'project', title: 'Projects' },
  { type: 'education', title: 'Education' },
] as const;

const entries = await getCollection('timeline');

// Ongoing entries first, then most recent start date
const sortKey = (entry: Entry) =>
  `${entry.data.endDate === 'present' ? '1' : '0'}${entry.data.startDate}`;

const sections = groups.map((group) => ({
  title: group.title,
  entries: entries
    .filter((entry) => entry.data.type === group.type)
    .toSorted((a, b) => sortKey(b).localeCompare(sortKey(a))),
}));
---

<Stack direction="col" gap={12}>
  {
    sections.map((section) => (
      <section>
        <Heading level={2} size="label" class="mb-4 font-normal text-muted-foreground">
          {section.title}
        </Heading>
        <Stack as="ul" direction="col" gap={4} class="sm:gap-3">
          {section.entries.map((entry) => (
            <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-6">
              <p class="min-w-0">
                {entry.data.organization_url ? (
                  <Link
                    href={entry.data.organization_url}
                    variant="plain"
                    class="font-medium text-foreground underline-offset-4 hover:underline"
                  >
                    {entry.data.organization}
                  </Link>
                ) : (
                  <Text as="span" weight="medium" class="text-foreground">
                    {entry.data.organization}
                  </Text>
                )}
                <Text as="span" tone="muted" class="block sm:ml-2 sm:inline">
                  {entry.data.title}
                </Text>
              </p>
              <Text as="span" size="sm" tone="muted" class="whitespace-nowrap tabular-nums">
                {formatPeriod(entry.data.startDate, entry.data.endDate)}
              </Text>
            </li>
          ))}
        </Stack>
      </section>
    ))
  }
</Stack>

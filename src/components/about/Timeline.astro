---
import { getCollection, type CollectionEntry } from 'astro:content';

import { formatPeriod } from '@/lib/format';

type Entry = CollectionEntry<'timeline'>;

const groups = [
  { type: 'experience', title: 'Work' },
  { type: 'project', title: 'Projects' },
  { type: 'education', title: 'Education' },
] as const;

const entries = await getCollection('timeline');

// Ongoing entries first, then most recent start date
const sortKey = (entry: Entry) =>
  `${entry.data.endDate === 'present' ? '1' : '0'}${entry.data.startDate}`;

const sections = groups.map((group) => ({
  title: group.title,
  entries: entries
    .filter((entry) => entry.data.type === group.type)
    .toSorted((a, b) => sortKey(b).localeCompare(sortKey(a))),
}));
---

<div class="space-y-12">
  {
    sections.map((section) => (
      <section>
        <h2 class="text-muted-foreground mb-4 text-sm">{section.title}</h2>
        <ul class="space-y-4 sm:space-y-3">
          {section.entries.map((entry) => (
            <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-6">
              <p class="min-w-0">
                {entry.data.organization_url ? (
                  <a
                    href={entry.data.organization_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-foreground font-medium underline-offset-4 hover:underline"
                  >
                    {entry.data.organization}
                  </a>
                ) : (
                  <span class="text-foreground font-medium">{entry.data.organization}</span>
                )}
                <span class="text-muted-foreground block sm:ml-2 sm:inline">{entry.data.title}</span>
              </p>
              <span class="text-muted-foreground text-sm whitespace-nowrap tabular-nums">
                {formatPeriod(entry.data.startDate, entry.data.endDate)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

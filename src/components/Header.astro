---
import Logo from '@/components/logo/logo';
import Search from '@/components/search/search.astro';
import { routes } from '@/configs/routes';
import MobileNav from './nav/header/mobile.astro';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const normalizedPathname = pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;

const navigation = [
  { name: 'Home', href: routes.home },
  { name: 'Blog', href: routes.blogs },
  { name: 'Notes', href: routes.notes },
  { name: 'About', href: routes.about },
  { name: 'Contact', href: routes.contact },
];

const activeHref = navigation.find(({ href }) =>
  href === '/'
    ? normalizedPathname === '/'
    : normalizedPathname === href || normalizedPathname.startsWith(`${href}/`)
)?.href;
---

<header
  class="bg-background/95 sticky top-0 z-50 w-full border-b border-transparent backdrop-blur-sm transition-all duration-300 ease-in-out"
  id="header"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2 lg:px-8"
    aria-label="Global"
  >
    <!-- Logo -->
    <div class="flex items-center">
      <a
        href={routes.home}
        class="flex items-center gap-3 transition-opacity duration-200 hover:opacity-80"
        aria-label="Go to homepage"
      >
        <Logo class="h-7" with_text={false} />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex md:items-center md:gap-1">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative px-3 py-1.5 text-sm font-medium transition-colors duration-200',
              item.href === activeHref
                ? 'text-foreground'
                : 'text-muted-foreground hover:text-foreground',
            ]}
            aria-current={item.href === activeHref ? 'page' : undefined}
          >
            {item.name}
            {/* Active indicator - elegant underline */}
            {item.href === activeHref && (
              <div class="bg-foreground absolute bottom-0 left-1/2 h-px w-6 -translate-x-1/2 transition-all duration-200" />
            )}
          </a>
        ))
      }
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <Search />
      <ThemeToggle />

      <!-- Mobile Navigation -->
      <MobileNav navigation={navigation} activeHref={activeHref} />
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('header');
    if (!header) return;

    const menuTrigger = header.querySelector<HTMLButtonElement>('#mobile-nav-trigger');
    let lastScrollY = 0;
    let ticking = false;

    // Enhanced scroll effects with hide/show functionality
    const handleScroll = () => {
      const currentScrollY = window.scrollY;
      const scrolledDown = currentScrollY > lastScrollY;
      const scrolledUp = currentScrollY < lastScrollY;
      const isAtTop = currentScrollY <= 10;
      const isEngaged =
        header.contains(document.activeElement) ||
        menuTrigger?.getAttribute('aria-expanded') === 'true';

      if (isEngaged || scrolledUp || isAtTop) {
        header.style.transform = 'translateY(0)';
      } else if (scrolledDown && currentScrollY > 100) {
        header.style.transform = 'translateY(-100%)';
      }

      // Border effects
      if (currentScrollY > 10) {
        header.classList.add('border-border/20', 'shadow-sm');
        header.classList.remove('border-transparent');
      } else {
        header.classList.remove('border-border/20', 'shadow-sm');
        header.classList.add('border-transparent');
      }

      lastScrollY = currentScrollY;
    };

    header.addEventListener('focusin', () => {
      header.style.transform = 'translateY(0)';
      lastScrollY = window.scrollY;
    });

    // Optimized scroll handler
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    handleScroll(); // Initial check
  });
</script>

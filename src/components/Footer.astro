---
import { SocialLinks } from '@/components/social';
import { Container } from '@/components/ui/container';
import { Text } from '@/components/ui/text';
import { socialLinks } from '@/configs/social';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-accent bg-primary/10 py-6">
  <Container class="flex flex-col items-center justify-between gap-4 md:flex-row">
    <SocialLinks
      links={socialLinks}
      iconClass="size-6"
      class="justify-center gap-x-6 gap-y-2 md:order-2"
    />
    <Text size="sm" tone="muted" class="text-center leading-5 md:order-1">
      Made with ❤️‍🔥 by romaingrx. &copy; {currentYear}. All rights reserved.
    </Text>
  </Container>
</footer>

---
import { Icon } from 'astro-icon/components';
import Button from '@/components/ui/button.astro';
---

<Button
  variant="ghost"
  size="icon"
  id="theme-toggle"
  aria-label="Change theme (currently System)"
  title="Theme: System"
  className="relative"
  transition:persist
>
  <!-- Light icon -->
  <Icon
    name={'lucide:sun'}
    class="theme-light:rotate-0 theme-light:scale-100 theme-dark:-rotate-90 theme-dark:scale-0 theme-system:-rotate-90 theme-system:scale-0 absolute size-5 scale-100 rotate-0 transition-all"
  />

  <!-- Dark icon -->
  <Icon
    name={'lucide:moon'}
    class="theme-light:rotate-90 theme-light:scale-0 theme-dark:rotate-0 theme-dark:scale-100 theme-system:rotate-90 theme-system:scale-0 absolute size-5 scale-0 rotate-90 transition-all"
  />

  <!-- System icon -->
  <Icon
    name={'lucide:monitor'}
    class="theme-light:rotate-90 theme-light:scale-0 theme-dark:rotate-90 theme-dark:scale-0 theme-system:rotate-0 theme-system:scale-100 absolute size-5 scale-0 rotate-90 transition-all"
  />
</Button>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const controller = window.themeController;
  const labels = { light: 'Light', dark: 'Dark', system: 'System' };

  if (themeToggle && controller && !themeToggle.dataset.themeControllerBound) {
    themeToggle.dataset.themeControllerBound = 'true';
    const updateLabel = ({ preference, resolved }: ThemeState) => {
      const label =
        preference === 'system'
          ? `Theme: System (${labels[resolved]})`
          : `Theme: ${labels[preference]}`;
      themeToggle.setAttribute('aria-label', `${label}. Activate to change theme`);
      themeToggle.setAttribute('title', label);
    };

    controller.subscribe(updateLabel);
    themeToggle.addEventListener('click', () => controller.cycleTheme());
  }
</script>

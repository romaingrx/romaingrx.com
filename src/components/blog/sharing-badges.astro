---
import { Icon } from 'astro-icon/components';
import { Button, Input, Link } from '@/components/ui';
import { platforms_info, type Platform } from '@/configs/platforms';
import { getAuthorsWithSocialLinks } from '@/lib/authors';
import type { BlogPostWithAuthors, NoteWithAuthors } from '@/lib/collections';

interface Props {
  post: BlogPostWithAuthors | NoteWithAuthors;
}

const { post } = Astro.props;

interface LinkProps {
  title: string;
  pathname: string;
  params?: Record<string, string | undefined>;
}

const xAuthors = getAuthorsWithSocialLinks({ authors: post.authors, platform: 'twitter' });
if (xAuthors.length > 1) {
  console.warn(`Found ${xAuthors.length} authors with a twitter handle; sharing uses the first.`);
}
const xAuthor = xAuthors[0];
const links: Partial<Record<Platform, LinkProps>> = {
  twitter: {
    title: `Share ${post.data.title} on X`,
    pathname: '/intent/post',
    params: {
      url: post.url,
      via: xAuthor?.data.socialLinks.twitter?.handle,
      related: xAuthors
        .map((author) => {
          const handle = author.data.socialLinks.twitter?.handle;
          return handle ? `${handle}:${author.data.title ?? author.data.name}` : undefined;
        })
        .filter((value): value is string => value !== undefined)
        .join(','),
      hashtags: post.data.tags.join(','),
    },
  },
  hackernews: {
    title: `Share ${post.data.title} on Hacker News`,
    pathname: '/submitlink',
    params: { u: post.url, t: post.data.title },
  },
  linkedin: {
    title: `Share ${post.data.title} on LinkedIn`,
    pathname: '/sharing/share-offsite',
    params: { url: post.url },
  },
};
---

<div class="space-y-2" data-content-share data-share-title={post.data.title}>
  <div class="flex flex-wrap items-center gap-1.5">
    {
      Object.entries(links).map(([platformName, props]) => {
        if (!props) return null;
        const platform = platformName as Platform;
        const platformInfo = platforms_info[platform];
        const anchorUrl = new URL(props.pathname, platformInfo.base_url);
        for (const [key, value] of Object.entries(props.params ?? {})) {
          if (value) anchorUrl.searchParams.set(key, value);
        }
        return (
          <Link
            href={anchorUrl.toString()}
            target="_blank"
            rel="noopener noreferrer"
            variant="ghost"
            size="icon"
            aria-label={props.title}
            title={props.title}
          >
            <Icon name={platformInfo.icon_name} class="size-5" />
          </Link>
        );
      })
    }
    <Button
      type="button"
      size="sm"
      variant="secondary"
      className="min-h-11 shrink-0"
      data-copy-link
    >
      <Icon name="lucide:link" class="size-4" />
      Copy link
    </Button>
    <Button
      type="button"
      size="sm"
      variant="secondary"
      className="min-h-11 shrink-0"
      data-native-share
      hidden
    >
      <Icon name="lucide:share-2" class="size-4" />
      Share
    </Button>
  </div>
  <p class="text-muted-foreground text-sm" role="status" aria-live="polite" data-share-status></p>
  <div class="w-full space-y-1" data-share-fallback hidden>
    <label class="text-muted-foreground mb-1 block text-sm" for={`share-url-${post.id}`}>
      Select this URL to copy it
    </label>
    <Input
      id={`share-url-${post.id}`}
      className="w-full"
      type="url"
      value={post.url}
      readonly
      data-share-url
    />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-content-share]').forEach((root) => {
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    const fallback = root.querySelector<HTMLElement>('[data-share-fallback]');
    const urlField = root.querySelector<HTMLInputElement>('[data-share-url]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-copy-link]');
    const shareButton = root.querySelector<HTMLButtonElement>('[data-native-share]');
    const url = urlField?.value;

    if (!status || !fallback || !urlField || !copyButton || !shareButton || !url) return;
    if (typeof navigator.share === 'function') {
      shareButton.hidden = false;
    }

    const showFallback = () => {
      fallback.hidden = false;
    };

    copyButton.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(url);
        status.textContent = 'Link copied.';
      } catch {
        showFallback();
        status.textContent = 'Copy failed. Select the URL below to copy it.';
      }
    });

    shareButton.addEventListener('click', async () => {
      try {
        await navigator.share({ title: root.dataset.shareTitle ?? '', url });
        status.textContent = 'Link shared.';
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') {
          status.textContent = 'Sharing canceled.';
          return;
        }
        showFallback();
        status.textContent = 'Sharing failed. Select the URL below to copy it.';
      }
    });
  });
</script>

<style>
  [data-content-share] [data-native-share][hidden] {
    display: none !important;
  }
</style>

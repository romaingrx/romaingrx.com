---
import StackedAuthors from '@/components/blog/author/stacked-authors.astro';
import Shell from '@/components/Shell.astro';
import { resolveResourceValue } from '@/configs/resources';
import type { BlogPostWithAuthors } from '@/lib/collections';
import Time from '../ui/time.astro';
import BlogPostBackground from './card/background';

interface Props {
  post: BlogPostWithAuthors;
  class?: string;
}

const { post, class: className = '' } = Astro.props;
const resources = post.data.resources.map((r) =>
  Object.assign({}, r, {
    value: resolveResourceValue(r.value, { collection: 'blog', entryId: post.id }),
  })
);
---

<header
  class:list={[
    'relative flex w-full flex-col items-center',
    'overflow-hidden rounded-b-xl py-8 sm:py-10',
    'animate-[fade-in-up_0.5s_ease-out_both]',
    className,
  ]}
>
  <!-- Background with subtle gradient -->
  <div class="absolute inset-0 opacity-20">
    <BlogPostBackground value={post.id} />
  </div>

  <!-- Main Content -->
  <div class="w-full">
    <Shell type="article">
      <div class="relative z-10 mx-auto text-center">
        <h1
          class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
          data-pagefind-meta="title"
        >
          {post.data.title}
        </h1>

        <p
          class="text-muted-foreground mx-auto mt-4 max-w-3xl text-base sm:text-lg"
          data-pagefind-meta="description"
        >
          {post.data.description}
        </p>

        <div
          class="text-muted-foreground mt-5 flex flex-col items-center gap-2 text-sm sm:flex-row sm:justify-center sm:gap-x-3"
          data-pagefind-ignore
          data-post-meta
        >
          {
            post.authors.length > 0 && (
              <div class="text-foreground flex items-center gap-2">
                <StackedAuthors authors={post.authors} show_name={false} />
                <span>{post.authors.map((author) => author.data.name).join(', ')}</span>
              </div>
            )
          }
          {
            post.authors.length > 0 && (
              <span class="hidden sm:inline" aria-hidden="true">
                ·
              </span>
            )
          }
          <div class="flex items-center gap-2 whitespace-nowrap">
            <Time date={post.data.published_date} className="text-sm" />
            <span aria-hidden="true">·</span>
            <span>{post.readingTime}</span>
          </div>
        </div>

        {
          resources.length > 0 && (
            <ul
              class="text-muted-foreground mt-5 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm"
              data-pagefind-ignore
              aria-label="Post resources"
            >
              {resources.map((resource) => (
                <li>
                  <a
                    href={resource.value}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-foreground focus-visible:outline-focus decoration-border hover:decoration-foreground rounded-sm underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid"
                  >
                    {resource.title}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Shell>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: reduce) {
    header {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

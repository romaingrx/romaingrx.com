---
import AuthorStack from '@/components/entry/author-stack.astro';
import ResourceList from '@/components/entry/resource-list.astro';
import ShareLinks from '@/components/entry/share-links.astro';
import { Container } from '@/components/ui/container';
import { Text } from '@/components/ui/text';
import { Time } from '@/components/ui/time';
import type { BlogPost } from '@/lib/collections';
import ContinueReading from './continue-reading.astro';
import SmoothGradient from './smooth-gradient.astro';

interface Props {
  post: BlogPost;
  class?: string;
}

const { post, class: className = '' } = Astro.props;
---

<header
  class:list={[
    'relative flex w-full flex-col items-center justify-center',
    'overflow-hidden rounded-b-xl py-16',
    'min-h-[calc(100vh-4rem)]',
    'animate-[fade-in-up_0.5s_ease-out_both]',
    className,
  ]}
>
  <div class="absolute inset-0 opacity-20">
    <SmoothGradient seed={post.id} />
  </div>

  <Container size="article">
    <div class="relative z-10 mx-auto text-center">
      <div class="text-muted-foreground mb-8 flex items-center justify-center gap-2 text-sm">
        <Time date={post.data.published_date} class="text-sm" />
        <span class="leading-none">·</span>
        <span>{post.readingTime}</span>
      </div>

      <h1
        class="mb-6 bg-gradient-to-br from-gray-900 to-gray-700 bg-clip-text pb-1 text-4xl font-bold tracking-tight text-transparent md:text-5xl lg:text-6xl dark:from-white dark:to-gray-200"
        style="min-width: min(100%, 600px);"
      >
        {post.data.title}
      </h1>

      <Text tone="muted" class="mb-8 text-lg md:text-xl">
        {post.data.description}
      </Text>

      {
        post.resources.length > 0 && (
          <div class="relative mt-4">
            <div class="flex flex-col gap-3 text-start">
              <Text as="span" size="sm" tone="muted" weight="medium">Resources</Text>
              <ResourceList resources={post.resources} />
            </div>
          </div>
        )
      }

      <div class="relative mt-4 flex flex-row justify-between">
        <div class="flex flex-col gap-3 text-start">
          <Text as="span" size="sm" tone="muted" weight="medium">Written by</Text>
          <AuthorStack authors={post.authors} />
        </div>
        <div class="flex flex-col gap-3 text-start">
          <Text as="span" size="sm" tone="muted" weight="medium">Share on</Text>
          <ShareLinks entry={post} />
        </div>
      </div>
    </div>
  </Container>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 transform">
    <ContinueReading />
  </div>
</header>

<style>
  @media (prefers-reduced-motion: reduce) {
    header {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

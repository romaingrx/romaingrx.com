---
import { cn } from '@/lib/utils';

/** A grid of small pixel-art images (base64 PNG), two columns on mobile. */
interface Props {
  images: { src: string; label?: string }[];
  columns?: 3 | 4 | 6;
  size?: number;
  class?: string;
}

const { images, columns = 4, size = 64, class: className } = Astro.props;
const renderSize = size * 2;
const columnClass = { 3: 'sm:grid-cols-3', 4: 'sm:grid-cols-4', 6: 'sm:grid-cols-6' }[columns];
---

<div class={cn('grid grid-cols-2 gap-4', columnClass, className)}>
  {
    images.map((item, i) => (
      <div class="flex flex-col items-center gap-1">
        <div
          class="flex aspect-square w-full items-center justify-center rounded bg-black p-2"
          style={{ maxWidth: `${renderSize + 16}px` }}
        >
          <img
            src={`data:image/png;base64,${item.src}`}
            alt={item.label ?? `Image ${i + 1}`}
            width={renderSize}
            height={renderSize}
            loading="lazy"
            class="block aspect-square w-full max-w-full object-contain [image-rendering:pixelated]"
          />
        </div>
        {item.label && <span class="font-mono text-xs text-muted-foreground">{item.label}</span>}
      </div>
    ))
  }
</div>

---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Button from '@/components/ui/button.astro';
import { cn } from '@/lib/utils';

interface Props {
  src?: ImageMetadata;
  html?: string;
  alt?: string;
  caption?: string;
  className?: string;
  width?: number;
  height?: number;
}

const { src, html, alt = 'Image', caption, className, width, height } = Astro.props;
const dialogId = `image-viewer-${Math.random().toString(36).slice(2, 10)}`;
---

<figure class={cn('image-viewer my-6', className)} data-image-viewer>
  <button
    type="button"
    class="group focus-visible:outline-focus relative block w-full cursor-zoom-in appearance-none rounded-lg border-0 bg-transparent p-0 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid"
    aria-label={`Open image: ${alt}`}
    aria-haspopup="dialog"
    aria-controls={dialogId}
    data-image-trigger
  >
    {
      html ? (
        <span class="block w-full [&>svg]:h-auto [&>svg]:w-full" set:html={html} />
      ) : src ? (
        <Image src={src} alt={alt} width={width} height={height} class="h-auto w-full" />
      ) : null
    }
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-lg opacity-0 ring-1 ring-current/5 transition-opacity duration-200 group-hover:opacity-100"
    ></span>
  </button>

  {
    caption && (
      <figcaption class="text-muted-foreground mt-3 text-center text-sm">{caption}</figcaption>
    )
  }

  <dialog
    id={dialogId}
    aria-label={`Image viewer: ${alt}`}
    class="image-viewer-dialog text-foreground fixed top-1/2 left-1/2 m-0 max-h-none max-w-none -translate-x-1/2 -translate-y-1/2 overflow-visible border-0 bg-transparent p-0 backdrop:bg-black/80"
    data-image-dialog
  >
    <div
      class="max-h-[calc(100dvh-2rem)] max-w-[calc(100vw-2rem)] overflow-auto rounded-lg bg-white p-4 shadow-2xl"
    >
      <div class="flex justify-end pb-2">
        <Button
          type="button"
          variant="ghost"
          size="icon"
          className="bg-black/60 text-white shadow-lg hover:bg-black/80 hover:text-white focus-visible:outline-black"
          aria-label="Close dialog"
          autofocus
          onclick="this.closest('dialog')?.close()"
        >
          <Icon name="lucide:x" class="size-5" />
        </Button>
      </div>
      {
        html ? (
          <div
            data-image-content
            class="[&>svg]:block [&>svg]:h-auto [&>svg]:max-h-[calc(100dvh-8rem)] [&>svg]:w-auto [&>svg]:max-w-[calc(100vw-4rem)]"
            set:html={html}
          />
        ) : src ? (
          <div data-image-content>
            <Image
              src={src}
              alt={alt}
              class="block h-auto max-h-[calc(100dvh-8rem)] w-auto max-w-[calc(100vw-4rem)] object-contain"
            />
          </div>
        ) : null
      }
    </div>
  </dialog>
</figure>

<script>
  import { enableBackdropDismissal, showModal } from '@/lib/dialog';

  document.querySelectorAll<HTMLElement>('[data-image-viewer]').forEach((viewer) => {
    const trigger = viewer.querySelector<HTMLButtonElement>('[data-image-trigger]');
    const dialog = viewer.querySelector<HTMLDialogElement>('[data-image-dialog]');

    if (!trigger || !dialog) return;

    enableBackdropDismissal(dialog);
    trigger.addEventListener('click', () => showModal(dialog, trigger));
  });
</script>

---
import { Icon } from 'astro-icon/components';
import Badge from '@/components/ui/badge.astro';
import { routes } from '@/configs/routes';

type Props = {
  category: string;
  isActive?: boolean;
};

const { category, isActive = false } = Astro.props;
---

<a href={isActive ? routes.blogs : routes.blogCategory(category)}>
  <Badge variant={isActive ? 'active' : 'secondary'} className="gap-1.5">
    <Icon name="lucide:folder" class="size-3" />
    <span>{category}</span>
  </Badge>
</a>

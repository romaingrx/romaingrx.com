---
import { Icon } from 'astro-icon/components';
import { Badge } from '@/components/ui/badge';
import { routes } from '@/configs/routes';

type Props = {
  category: string;
  isActive?: boolean;
  basePath?: string;
};

const { category, isActive = false, basePath = routes.blogs } = Astro.props;
---

<Badge
  href={isActive ? basePath : `${basePath}/category/${category}`}
  variant={isActive ? 'active' : 'secondary'}
  class="gap-1.5"
>
  <Icon name="lucide:folder" />
  <span>{category}</span>
</Badge>

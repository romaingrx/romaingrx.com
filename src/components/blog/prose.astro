---
import '@/styles/typography.css';
import '@/styles/citations.css';
import { cn } from '@/lib/utils';

export interface Props {
  Element?: 'article' | 'div';
  class?: string;
  id?: string;
}

const { Element = 'div', class: className, id } = Astro.props;
---

<Element id={id} tabindex={id ? -1 : undefined} class={cn('prose', className)}>
  <slot />
</Element>

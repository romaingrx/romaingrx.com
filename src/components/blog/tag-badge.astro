---
import { Icon } from 'astro-icon/components';
import Badge from '@/components/ui/badge.astro';
import { routes } from '@/configs/routes';

type Props = {
  tag: string;
  isActive?: boolean;
  collection?: 'blog' | 'note';
};

const { tag, isActive = false, collection = 'blog' } = Astro.props;
const basePath = collection === 'note' ? routes.notes : routes.blogs;
const tagPath = collection === 'note' ? routes.noteTag(tag) : routes.blogTag(tag);
---

<a href={isActive ? basePath : tagPath}>
  <Badge variant={isActive ? 'active' : 'secondary'} className="gap-1.5">
    <Icon name="lucide:tag" class="size-3" />
    <span>{tag}</span>
  </Badge>
</a>

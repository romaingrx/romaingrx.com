---
import { Icon } from 'astro-icon/components';
import { Badge } from '@/components/ui/badge';
import { routes } from '@/configs/routes';

type Props = {
  tag: string;
  isActive?: boolean;
  basePath?: string;
};

const { tag, isActive = false, basePath = routes.blogs } = Astro.props;
---

<Badge
  href={isActive ? basePath : `${basePath}/tag/${tag}`}
  variant={isActive ? 'active' : 'secondary'}
  class="gap-1.5"
>
  <Icon name="lucide:tag" />
  <span>{tag}</span>
</Badge>

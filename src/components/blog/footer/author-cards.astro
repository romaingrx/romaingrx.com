---
import { Image } from 'astro:assets';
import { SocialLinks } from '@/components/social';
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { Heading, Text } from '@/components/ui/text';
import { getAuthorSocialLinks } from '@/lib/authors';
import type { Author } from '@/lib/collections';

interface Props {
  authors: Author[];
}

const { authors } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
  {
    authors.map((author) => (
      <Card class="border-none bg-muted/50">
        <CardHeader>
          <div class="flex items-center gap-4">
            <Image
              src={author.data.image}
              alt={author.data.name}
              width={56}
              height={56}
              class="rounded-lg ring-2 ring-border"
            />
            <div>
              <Heading level={3} size="subsection" class="text-lg">
                {author.data.name}
              </Heading>
              {author.data.title && (
                <Text size="sm" tone="muted">
                  {author.data.title}
                </Text>
              )}
            </div>
          </div>
        </CardHeader>
        <CardContent>
          <SocialLinks links={getAuthorSocialLinks(author)} />
        </CardContent>
      </Card>
    ))
  }
</div>

---
import { Icon } from 'astro-icon/components';
import DiscussOn from '@/components/blog/discuss-on.astro';
import Comments from '@/components/comments.astro';
import { resolveResourceValue } from '@/configs/resources';
import type { BlogPostWithAuthors } from '@/lib/collections';
import { formatDate } from '@/lib/format';
import CategoryBadge from '../category-badge.astro';
import ResourceBadges from '../resources/index.astro';
import TagBadge from '../tag-badge.astro';
import AuthorCards from './author-cards.astro';
import RelatedPosts from './related-posts.astro';
import { Heading } from '@/components/ui/text';

interface Props {
  post: BlogPostWithAuthors;
}

const { post } = Astro.props;
const { authors } = post;
const { tags, categories, updated_date, related_posts } = post.data;
const resources = post.data.resources.map((r) =>
  Object.assign({}, r, { value: resolveResourceValue(r.value, { collection: 'blog', entryId: post.id }) })
);
const hasRelatedContent = related_posts || tags.length > 0;
---

<footer class="mt-16 flex flex-col gap-8">
  <hr />

  <!-- Thank You & Discuss Section -->
  <DiscussOn post={post} />

  <!-- Metadata Section -->
  {
    [resources.length, tags.length, categories.length, updated_date].some(Boolean) && (
  <div class="flex rounded-lg border bg-card p-6 text-card-foreground shadow-sm">
    <div class="space-y-6">
      <!-- Tags and Categories -->
      <div class="space-y-4">
        {
          resources.length > 0 && (
            <div class="space-y-3">
              <Heading level={3} size="label" class="font-medium text-muted-foreground">Resources</Heading>
              <ResourceBadges resources={resources} />
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="space-y-3">
              <Heading level={3} size="label" class="font-medium text-muted-foreground">Tags</Heading>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <TagBadge tag={tag} />
                ))}
              </div>
            </div>
          )
        }
        {
          categories.length > 0 && (
            <div class="space-y-3">
              <Heading level={3} size="label" class="font-medium text-muted-foreground">Categories</Heading>
              <div class="flex flex-wrap gap-2">
                {categories.map((category) => (
                  <CategoryBadge category={category} />
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- Update Information -->
      {
        updated_date && (
          <div class="text-muted-foreground flex items-center gap-2 text-sm">
            <Icon name="mdi:calendar-clock" class="size-4" />
            <span>Last updated on {formatDate(updated_date)}</span>
          </div>
        )
      }
    </div>
  </div>
    )
  }

  <!-- Authors Section (Hidden) -->
  {
    authors.length > 0 && (
      <div class="mb-16 hidden">
        <Heading level={2} class="mb-6">
          About the author{authors.length > 1 ? 's' : ''}
        </Heading>
        <AuthorCards authors={authors} />
      </div>
    )
  }

  <!-- Related Content Section -->
  {
    hasRelatedContent && (
      <div class="mb-16">
        <Heading level={2} class="mb-6">
          {post.data.related_posts ? 'Related Content' : 'More Posts'}
        </Heading>
        <RelatedPosts post={post} />
      </div>
    )
  }

  <!-- Comments Section -->
  <div class="my-8">
    <Comments />
  </div>
</footer>

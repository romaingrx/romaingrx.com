---
import BlogCard from '@/components/blog/card/index.astro';
import { routes } from '@/configs/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { BlogPostWithAuthors } from '@/lib/collections';
import { formatTaxonomyLabel } from '@/lib/format';
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  posts: BlogPostWithAuthors[];
  allPosts: BlogPostWithAuthors[];
  categories: string[];
  tags: string[];
  activeCategory?: string;
  activeTag?: string;
}

const { title, description, posts, allPosts, categories, tags, activeCategory, activeTag } =
  Astro.props;
const isAll = !activeCategory && !activeTag;
const filterClass = (active: boolean) =>
  cn(
    'rounded-full px-3 py-1.5 text-sm transition-colors focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
    active
      ? 'bg-accent/60 font-medium text-foreground'
      : 'text-muted-foreground hover:bg-accent hover:text-foreground'
  );
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>

    <nav class="mt-6" aria-label="Filter posts">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Categories">
        <span class="text-muted-foreground mr-1 text-sm">Categories</span>
        <a href={routes.blogs} aria-current={isAll ? 'page' : undefined} class={filterClass(isAll)}>
          All posts
          <span class="text-muted-foreground ml-1 text-xs tabular-nums">({allPosts.length})</span>
        </a>
        {
          categories.map((category) => {
            const active = activeCategory === category;
            const count = allPosts.filter((post) => post.data.categories.includes(category)).length;
            return (
              <a
                href={routes.blogCategory(category)}
                aria-current={active ? 'page' : undefined}
                class={filterClass(active)}
              >
                {formatTaxonomyLabel(category)}
                <span class="text-muted-foreground ml-1 text-xs tabular-nums">({count})</span>
              </a>
            );
          })
        }
      </div>
      {
        tags.length > 0 && (
          <details class="mt-2" open={Boolean(activeTag)}>
            <summary class="text-muted-foreground hover:text-foreground focus-visible:outline-focus w-fit cursor-pointer text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid">
              Tags
            </summary>
            <div class="mt-2 flex flex-wrap items-center gap-2" role="group" aria-label="Tags">
              {tags.map((tag) => {
                const active = activeTag === tag;
                const count = allPosts.filter((post) => post.data.tags.includes(tag)).length;
                return (
                  <a
                    href={routes.blogTag(tag)}
                    aria-current={active ? 'page' : undefined}
                    class={filterClass(active)}
                  >
                    {formatTaxonomyLabel(tag)}
                    <span class="text-muted-foreground ml-1 text-xs tabular-nums">({count})</span>
                  </a>
                );
              })}
            </div>
          </details>
        )
      }
    </nav>

    {
      posts.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-muted-foreground mt-10">No posts found.</p>
      )
    }
  </div>
</BaseLayout>

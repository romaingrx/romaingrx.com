---
import type { Heading } from '@/lib/toc';

type Props = {
  heading: Heading;
};

const { heading } = Astro.props;
---

<li>
  <a
    href={'#' + heading.slug}
    data-toc-link
    class="text-muted-foreground hover:text-foreground focus-visible:outline-focus hover:bg-muted/60 aria-[current=location]:bg-muted aria-[current=location]:text-foreground flex min-h-11 items-center rounded-md px-3 py-2 text-sm leading-snug focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid aria-[current=location]:font-semibold"
  >
    {heading.text}
  </a>
  {
    heading.subheadings.length > 0 && (
      <ul class="border-border ml-3 space-y-1 border-l pl-2">
        {heading.subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>

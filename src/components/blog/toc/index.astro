---
import type { MarkdownHeading } from 'astro';
import { buildToc } from '@/lib/toc';
import TocHeading from './heading.astro';

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;
const toc = buildToc(headings);
---

{
  toc.length > 0 && (
    <nav aria-labelledby="contents-label" class="my-8" data-reading-toc data-pagefind-ignore>
      <details class="border-border bg-card/40 rounded-lg border">
        <summary
          id="contents-label"
          class="focus-visible:outline-focus marker:text-muted-foreground min-h-11 cursor-pointer rounded-lg px-4 py-3 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid"
        >
          Contents
        </summary>
        <ul class="divide-border space-y-1 border-t px-2 py-2">
          {toc.map((heading) => (
            <TocHeading heading={heading} />
          ))}
        </ul>
      </details>
    </nav>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>('[data-reading-toc]');

  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]')];
    const targets = links
      .map((link) => ({
        link,
        heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
      }))
      .filter(
        (target): target is { link: HTMLAnchorElement; heading: HTMLElement } =>
          target.heading instanceof HTMLElement
      );

    targets.forEach(({ heading }) => {
      if (!heading.hasAttribute('tabindex')) heading.tabIndex = -1;
    });

    const updateCurrentSection = () => {
      const headerBottom = Math.max(
        0,
        document.getElementById('header')?.getBoundingClientRect().bottom ?? 0
      );
      const anchorOffset = Number.parseFloat(
        getComputedStyle(targets[0]?.heading ?? nav).scrollMarginTop
      );
      const boundary = Math.max(headerBottom, Number.isFinite(anchorOffset) ? anchorOffset : 0) + 2;
      let activeIndex = 0;

      targets.forEach(({ heading }, index) => {
        if (heading.getBoundingClientRect().top <= boundary) activeIndex = index;
      });

      links.forEach((link) => link.removeAttribute('aria-current'));
      const activeTarget = targets[activeIndex];
      if (activeTarget && activeTarget.heading.getBoundingClientRect().top <= boundary) {
        activeTarget.link.setAttribute('aria-current', 'location');
      }
    };

    let frame = 0;
    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateCurrentSection);
    };

    let alignmentFrame = 0;
    const alignFragment = (heading: HTMLElement) => {
      cancelAnimationFrame(alignmentFrame);
      alignmentFrame = requestAnimationFrame(() => {
        alignmentFrame = 0;
        if (heading.isConnected) {
          heading.focus({ preventScroll: true });
          heading.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
      });
    };

    const alignCurrentFragment = () => {
      let id = window.location.hash.slice(1);
      if (!id) return;

      try {
        id = decodeURIComponent(id);
      } catch {
        return;
      }

      const heading = document.getElementById(id);
      if (heading instanceof HTMLElement) alignFragment(heading);
    };

    nav.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLAnchorElement>('a[data-toc-link]');
      if (!link) return;

      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (heading instanceof HTMLElement) alignFragment(heading);
    });

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', () => {
      alignCurrentFragment();
      scheduleUpdate();
    });
    alignCurrentFragment();
    scheduleUpdate();
  }
</script>

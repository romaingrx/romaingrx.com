---
import type { MarkdownHeading } from 'astro';
import { buildToc } from '@/lib/toc';
import TocHeading from './heading.astro';

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;
const toc = buildToc(headings);
---

{
  toc.length > 0 && (
    <nav
      aria-label="Contents"
      class="page-gutter max-w-article relative mx-auto my-4 xl:mx-0 xl:my-0 xl:h-0 xl:max-w-none xl:px-0"
      data-reading-toc
      data-pagefind-ignore
    >
      <details class="group/toc relative" data-toc-details open>
        <summary class="marker:text-muted-foreground text-muted-foreground hover:text-foreground focus-visible:outline-focus min-h-11 cursor-pointer py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid xl:hidden">
          Contents
        </summary>
        <div class="max-w-article mx-auto mt-2 xl:mt-0" data-toc-rail>
          <ul class="border-border space-y-1 border-l pl-2 xl:space-y-0 xl:border-0 xl:pl-0">
            {toc.map((heading) => (
              <TocHeading heading={heading} />
            ))}
          </ul>
        </div>
      </details>
    </nav>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>('[data-reading-toc]');

  if (nav) {
    const disclosure = nav.querySelector<HTMLDetailsElement>('[data-toc-details]');
    const desktop = window.matchMedia('(min-width: 1280px)');
    const syncDisclosure = () => {
      if (disclosure) disclosure.open = desktop.matches;
    };
    syncDisclosure();
    desktop.addEventListener('change', syncDisclosure);

    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]')];
    const targets = links
      .map((link) => ({
        link,
        heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
      }))
      .filter(
        (target): target is { link: HTMLAnchorElement; heading: HTMLElement } =>
          target.heading instanceof HTMLElement
      );

    targets.forEach(({ heading }) => {
      if (!heading.hasAttribute('tabindex')) heading.tabIndex = -1;
    });

    const updateCurrentSection = () => {
      const headerBottom = Math.max(
        0,
        document.getElementById('header')?.getBoundingClientRect().bottom ?? 0
      );
      const anchorOffset = Number.parseFloat(
        getComputedStyle(targets[0]?.heading ?? nav).scrollMarginTop
      );
      const boundary = Math.max(headerBottom, Number.isFinite(anchorOffset) ? anchorOffset : 0) + 2;
      let activeIndex = 0;

      targets.forEach(({ heading }, index) => {
        if (heading.getBoundingClientRect().top <= boundary) activeIndex = index;
      });

      links.forEach((link) => link.removeAttribute('aria-current'));
      const activeTarget = targets[activeIndex];
      if (activeTarget && activeTarget.heading.getBoundingClientRect().top <= boundary) {
        activeTarget.link.setAttribute('aria-current', 'location');
      }
    };

    let frame = 0;
    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateCurrentSection);
    };

    let alignmentFrame = 0;
    const alignFragment = (heading: HTMLElement) => {
      cancelAnimationFrame(alignmentFrame);
      alignmentFrame = requestAnimationFrame(() => {
        alignmentFrame = 0;
        if (heading.isConnected) {
          heading.focus({ preventScroll: true });
          heading.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
      });
    };

    const alignCurrentFragment = () => {
      let id = window.location.hash.slice(1);
      if (!id) return;

      try {
        id = decodeURIComponent(id);
      } catch {
        return;
      }

      const heading = document.getElementById(id);
      if (heading instanceof HTMLElement) alignFragment(heading);
    };

    nav.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLAnchorElement>('a[data-toc-link]');
      if (!link) return;

      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (heading instanceof HTMLElement) alignFragment(heading);
    });

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', () => {
      alignCurrentFragment();
      scheduleUpdate();
    });
    alignCurrentFragment();
    scheduleUpdate();
  }
</script>

<style is:global>
  @media (min-width: 80rem) {
    [data-toc-rail] {
      position: fixed;
      inset-block-start: 6rem;
      inset-inline-end: 1.5rem;
      z-index: 40;
      box-sizing: border-box;
      width: 4rem;
      max-height: calc(100dvh - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      border: 1px solid transparent;
      border-radius: var(--radius-lg);
      padding: 0;
      transition:
        width var(--motion-duration-normal) var(--motion-ease-standard),
        border-color var(--motion-duration-normal) var(--motion-ease-standard),
        background-color var(--motion-duration-normal) var(--motion-ease-standard),
        padding var(--motion-duration-normal) var(--motion-ease-standard);
    }

    [data-toc-rail]:is(:hover, :focus-within) {
      width: 16rem;
      border-color: var(--border);
      background-color: var(--card);
      padding: 0.75rem;
    }

    [data-toc-rail] [data-toc-link] {
      min-height: 1rem;
      justify-content: center;
      padding-block: 0;
      padding-inline: 0;
      background-color: transparent;
    }

    [data-toc-rail] [data-toc-link][aria-current='location'] {
      background-color: transparent;
    }

    [data-toc-rail] [data-toc-link]::before {
      position: absolute;
      inset-block-start: 50%;
      height: 2px;
      transform: translateY(-50%);
      border-radius: 9999px;
      background-color: var(--muted-foreground);
      content: '';
    }

    [data-toc-rail] [data-toc-depth='2']::before {
      inset-inline-start: 1.375rem;
      width: 1.125rem;
    }

    [data-toc-rail] [data-toc-depth='3']::before {
      inset-inline-start: 1.5rem;
      width: 1rem;
      opacity: 0.65;
    }

    [data-toc-rail] [data-toc-depth='4']::before {
      inset-inline-start: 1.625rem;
      width: 0.875rem;
      opacity: 0.5;
    }

    [data-toc-rail] [data-toc-depth='5']::before,
    [data-toc-rail] [data-toc-depth='6']::before {
      inset-inline-start: 1.75rem;
      width: 0.75rem;
      opacity: 0.4;
    }

    [data-toc-rail] [data-toc-link][aria-current='location']::before {
      background-color: var(--foreground);
      opacity: 1;
    }

    [data-toc-rail] [data-toc-link] > span {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    [data-toc-rail]:is(:hover, :focus-within) [data-toc-link] {
      min-height: 2rem;
      justify-content: flex-start;
      padding-inline: 0.75rem;
      background-color: transparent;
    }

    [data-toc-rail]:is(:hover, :focus-within) [data-toc-link]::before {
      display: none;
    }

    [data-toc-rail]:is(:hover, :focus-within) [data-toc-link] > span {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }

    [data-toc-rail]:is(:hover, :focus-within) [data-toc-link][aria-current='location'] {
      background-color: var(--muted);
    }

    [data-toc-rail]:is(:hover, :focus-within) ul ul {
      margin-inline-start: 0.75rem;
      border-inline-start: 1px solid var(--border);
      padding-inline-start: 0.5rem;
    }
  }

  @media (min-width: 80rem) and (pointer: coarse) {
    [data-toc-rail] [data-toc-link],
    [data-toc-rail]:is(:hover, :focus-within) [data-toc-link] {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toc-rail] {
      transition: none;
    }
  }
</style>

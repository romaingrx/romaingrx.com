---
import {
  Alert,
  Badge,
  Button,
  Dialog,
  Input,
  Label,
  Link,
  Loading,
  Textarea,
} from '@/components/ui';
import { Badge as ReactBadge } from '@/components/ui/react/badge';
import { Button as ReactButton } from '@/components/ui/react/button';
import { Settings } from 'lucide-react';
import { Icon } from 'astro-icon/components';
import '@/styles/typography.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/design/section.astro';
import ImageViewer from '@/components/blog/components/images/image-viewer.astro';

const diagramOne =
  '<svg xmlns="http://www.w3.org/2000/svg" width="320" height="180" viewBox="0 0 320 180"><rect width="320" height="180" rx="12" fill="#d5ac7c"/><text x="160" y="96" text-anchor="middle" font-size="24" fill="#30251d">Diagram one</text></svg>';
const diagramTwo =
  '<svg xmlns="http://www.w3.org/2000/svg" width="320" height="180" viewBox="0 0 320 180"><rect width="320" height="180" rx="12" fill="#8fa7a0"/><text x="160" y="96" text-anchor="middle" font-size="24" fill="#202a27">Diagram two</text></svg>';
---

<BaseLayout title="Design fixture" description="Development-only component fixture">
  <div data-pagefind-ignore>
    <Section title="Alert">
      <Alert icon="lucide:brain" title="My title">
        <div>This alert identifies the active component fixture.</div>
      </Alert>
      <Alert
        data-design-error-alert
        icon="lucide:circle-alert"
        title="Validation error"
        variant="destructive"
      >
        <div>Check the highlighted field before you continue.</div>
      </Alert>
    </Section>

    <Section title="Button and dialog">
      <Button
        type="button"
        onclick="document.getElementById('my-modal').showModal()"
        variant="ghost">Edit Profile</Button
      >
      <Dialog id="my-modal" title="My title" description="My description">
        <div>Edit profile fields appear here.</div>
      </Dialog>
    </Section>

    <Section title="Native image dialogs">
      <div class="grid gap-6 md:grid-cols-2">
        <ImageViewer html={diagramOne} alt="Diagram one" />
        <ImageViewer html={diagramTwo} alt="Diagram two" />
      </div>
    </Section>

    <Section title="Control matrix">
      <div id="control-matrix" class="flex flex-wrap items-center gap-3">
        <Button data-astro-control="action" type="button">Astro action</Button>
        <Button data-astro-control="compact" type="button" variant="outline" size="sm">
          Astro compact
        </Button>
        <Button
          data-astro-control="icon"
          type="button"
          variant="ghost"
          size="icon"
          aria-label="Astro settings"
        >
          <Icon name="lucide:settings" />
        </Button>
        <Button
          data-astro-control="loading"
          type="button"
          variant="secondary"
          disabled
          aria-busy="true"
          aria-label="Saving Astro changes"
        >
          Saving
        </Button>
        <Link data-astro-control="link" href="#control-matrix-target" variant="outline" size="sm">
          Astro link
        </Link>
        <Badge data-astro-badge variant="secondary">Astro badge</Badge>
        <ReactButton data-react-control="action" type="button">React action</ReactButton>
        <ReactButton data-react-control="compact" type="button" variant="outline" size="sm">
          React compact
        </ReactButton>
        <ReactButton
          data-react-control="icon"
          type="button"
          variant="ghost"
          size="icon"
          aria-label="React settings"
        >
          <Settings />
        </ReactButton>
        <ReactButton
          data-react-control="loading"
          type="button"
          variant="secondary"
          disabled
          aria-busy="true"
          aria-label="Saving React changes"
        >
          Saving
        </ReactButton>
        <ReactBadge data-react-badge variant="secondary">Ready</ReactBadge>
      </div>
      <span id="control-matrix-target" class="sr-only">Control matrix target</span>
    </Section>

    <Section title="Fields and status">
      <div class="grid max-w-md gap-3">
        <Label for="design-name">Display name</Label>
        <Input id="design-name" placeholder="Your name" aria-invalid="true" />
        <Label for="design-notes">Notes</Label>
        <Textarea id="design-notes" placeholder="A short note" value="Prefilled note" />
      </div>
    </Section>

    <Section title="Loading state">
      <Loading />
    </Section>

    <Section title="Tokens and typography">
      <article class="prose" data-design-typography>
        <p data-design-reading>
          Reading text uses Fira Sans, while <code data-design-code>code stays monospaced</code>.
          <a href="#token-target">Article links stay visible</a> in every theme.
        </p>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" aria-label="Status token examples">
          <span
            data-design-status
            class="rounded px-2 py-1 text-xs"
            style="background: var(--status-success); color: var(--background);">Success</span
          >
          <span
            data-design-status
            class="rounded px-2 py-1 text-xs"
            style="background: var(--status-warning); color: var(--background);">Warning</span
          >
          <span
            data-design-status
            class="rounded px-2 py-1 text-xs"
            style="background: var(--status-info); color: var(--background);">Info</span
          >
          <span
            data-design-status
            class="rounded px-2 py-1 text-xs"
            style="background: var(--status-error); color: var(--background);">Error</span
          >
        </div>
        <img
          data-design-article-image
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
          alt=""
          width="240"
          height="80"
          style="width: 240px; height: 80px;"
        />
        <div data-design-media-widget class="mt-4 rounded border p-2">
          <img
            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
            alt=""
            width="240"
            height="80"
            style="width: 240px; height: 80px;"
          />
        </div>
        <span id="token-target" class="sr-only">Token target</span>
      </article>
    </Section>
  </div>
</BaseLayout>
